{#
  TERAZ 2.0 — قسم knit (home.teraz-strip-knit)
#}
{% set c = component|default({}) %}
{% set prods = [] %}
{% for p in c.products|default([]) %}
  {% set prods = prods|merge([{
    id: p.id,
    sku: p.sku,
    name: p.name,
    url: p.url,
    price: p.price ? (p.price|money) : 0,
    image: p.image.url|default('')
  }]) %}
{% endfor %}
{% set strip_ovr = {
  knitTitle: c.title|default(''), knitSub: c.text|default(''),
  sallaProducts: prods
} %}
<script>
window.TERAZ_QUEUE_OVERRIDE({{ strip_ovr|json_encode|raw }});
</script>
