{# TERAZ 2.0 — Parallax Background (home.parallax-background) #}
{% set raed_dummies = ['MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH', '3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K', 'D7bG3pgSit43TheOejBOZV7LIfG1y1Cj0hWLmgIh', 'pzOCEw10wCfXeVSpKnL0Ifd1O9ZkTfnZ17RkE14R', 'lkyDjYwvWJNmAQoGnLALLcUkm66rCCDbTyVlSGdH'] %}
{% set u = image.url|default('') %}
{% set is_dummy = false %}
{% for h in raed_dummies %}{% if h in u %}{% set is_dummy = true %}{% endif %}{% endfor %}
{% if u and not is_dummy %}
<section component-id="{{ componentId }}" data-testid="store-home-parallax-banner" class="teraz-parallax-banner">
  <div class="teraz-parallax-inner" style="background-image: url('{{ u }}');">
    <div class="teraz-parallax-content">
      {% if title %}<h2>{{ title }}</h2>{% endif %}
      {% if url and link_text %}<a href="{{ url }}" class="primary">{{ link_text }} <span>←</span></a>{% endif %}
    </div>
  </div>
</section>
{% endif %}
