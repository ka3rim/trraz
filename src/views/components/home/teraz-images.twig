{#
  TERAZ 2.0 — التحكم الكامل بصور الواجهة والأقسام والعروض والمنتجات (home.teraz-images)
#}
{% set c = component|default({}) %}
{% set direct_prods = {
  'tuwaiq': c.img_tuwaiq|default(''),
  'badr': c.img_badr|default(''),
  'night': c.img_night|default(''),
  'oud': c.img_oud|default(''),
  'ramth': c.img_ramth|default(''),
  'evening': c.img_evening|default(''),
  'dahna': c.img_dahna|default(''),
  'coffee': c.img_coffee|default(''),
  'mule-0': c.img_mule_0|default(''),
  'mule-1': c.img_mule_1|default(''),
  'mule-2': c.img_mule_2|default(''),
  'care-pack': c.img_care_pack|default('')
} %}
{% set ovr_payload = {
  logo: c.logo|default(''),
  heroBg: c.hero_bg|default(''),
  categories: {
    mule: c.cat_mule|default(''),
    clogs: c.cat_clogs|default(''),
    caps: c.cat_caps|default(''),
    socks: c.cat_socks|default(''),
    care: c.cat_care|default('')
  },
  offers: {
    single: c.offer_single|default(''),
    starter: c.offer_starter|default(''),
    pair2: c.offer_pair2|default('')
  },
  products: direct_prods
} %}
<script>
window.TERAZ_QUEUE_OVERRIDE({{ ovr_payload|json_encode|raw }});
{% if c.product_images is defined and c.product_images|length %}
window.TERAZ_QUEUE_OVERRIDE({ products: {{ c.product_images|json_encode|raw }} });
{% endif %}
</script>
