{#
  TERAZ 2.0 — قصة الخامة (home.teraz-material-story)
#}
{% set c = component|default({}) %}
{% if c.image or c.title or c.eyebrow %}
<section class="material-story" component-id="{{ componentId|default('') }}">
  <div class="material-art"><img src="{{ c.image|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige-white.webp') }}" alt="{{ c.image_alt|default('تفاصيل النسيج والجلد في ثرى طويق') }}" loading="lazy"></div>
  <div>
    <span class="eyebrow">{{ c.eyebrow|default('القيمة في اللي تلبسه') }}</span>
    <h2>{{ c.title|default('من النسيج
إلى آخر خطوة.')|nl2br }}</h2>
    <p>{{ c.text|default('في الموديلات الأصلية: نسيج بوليستر محاك، تفاصيل جلد طبيعي، قاعدة بولي يوريثان، وفرشة مغطاة بجلد الماعز.') }}</p>
    <a class="underlined" href="{{ c.link_url|default('#p/tuwaiq') }}">{{ c.link_label|default('اكتشف ثرى طويق عن قرب ↗') }}</a>
  </div>
</section>
{% endif %}
