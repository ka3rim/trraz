{#
  TERAZ 2.0 — قسم socks (home.teraz-strip-socks)
#}
{% set c = component|default({}) %}
{% set prods = [] %}
{% for p in c.products|default([]) %}
  {% set prods = prods|merge([{
    id: p.id,
    sku: p.sku,
    name: p.name,
    url: p.url,
    price: p.price ? (p.price|money) : 0,
    status: p.status|default('sale'),
    is_available: p.is_available is defined ? (p.is_available ? true : false) : (p.status|default('sale') != 'out'),
    is_out_of_stock: p.is_out_of_stock|default(false),
    quantity: p.quantity is defined ? p.quantity : null,
    type: p.type|default('product'),
    image: p.image.url|default('')
  }]) %}
{% endfor %}
{% set strip_ovr = {
  categories: { 'socks': { image: c.image|default(''), name: c.title|default(''), line: c.text|default('') } },
  sallaProducts: prods
} %}
<script>
window.TERAZ_QUEUE_OVERRIDE({{ strip_ovr|json_encode|raw }});
</script>
