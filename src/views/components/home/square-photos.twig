{# TERAZ 2.0 — Square Photos (home.square-photos) #}
{% set raed_dummies = ['MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH', '3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K', 'D7bG3pgSit43TheOejBOZV7LIfG1y1Cj0hWLmgIh', 'pzOCEw10wCfXeVSpKnL0Ifd1O9ZkTfnZ17RkE14R', 'lkyDjYwvWJNmAQoGnLALLcUkm66rCCDbTyVlSGdH'] %}
{% set valid_items = [] %}
{% for item in items|default([]) %}
  {% set u = item.image.url|default('') %}
  {% set is_dummy = false %}
  {% for h in raed_dummies %}{% if h in u %}{% set is_dummy = true %}{% endif %}{% endfor %}
  {% if u and not is_dummy %}{% set valid_items = valid_items|merge([item]) %}{% endif %}
{% endfor %}
{% if valid_items|length %}
<section component-id="{{ componentId }}" data-testid="store-home-square-photos" class="teraz-custom-banners-grid">
  {% if title %}<header class="section-heading"><div><h2>{{ title }}</h2></div></header>{% endif %}
  <div class="teraz-banners-row">
    {% for item in valid_items %}
      <a href="{{ item.url|default('#knit') }}" class="teraz-banner-card" {% if item.link_type == 'external_link' %}target="_blank" rel="noopener"{% endif %}>
        <img src="{{ item.image.url }}" alt="{{ item.image.alt|default(item.text|default('طراز')) }}" loading="lazy">
        {% if item.text %}
          <div class="teraz-banner-caption"><h3>{{ item.text }}</h3></div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}
