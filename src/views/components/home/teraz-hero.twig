{#
  TERAZ 2.0 — المنصة الرئيسية (home.teraz-hero)
#}
{% set c = component|default({}) %}
{% set sub_text = ((c.text_line_1|default('')) ~ ' ' ~ (c.text_line_2|default('')))|trim %}
{% set hero_prods = [] %}
{% for p in c.hero_products|default([]) %}
  {% set hero_prods = hero_prods|merge([{
    id: p.id,
    sku: p.sku,
    name: p.name,
    url: p.url,
    price: p.price ? (p.price|money) : 0,
    status: p.status|default('sale'),
    is_available: p.is_available is defined ? (p.is_available ? true : false) : (p.status|default('sale') != 'out'),
    is_out_of_stock: p.is_out_of_stock|default(false),
    quantity: p.quantity is defined ? p.quantity : null,
    type: p.type|default('product'),
    image: p.image.url|default('')
  }]) %}
{% endfor %}
{% set hero_ovr = {
  heroBg: c.stage_image|default(''),
  heroEyebrow: c.eyebrow|default(''),
  heroTitle: c.title|default(''),
  heroSub: sub_text,
  heroBtnLabel: c.button_label|default(''),
  heroBtnLink: c.button_link|default(''),
  sallaProducts: hero_prods
} %}
<script>
window.TERAZ_QUEUE_OVERRIDE({{ hero_ovr|json_encode|raw }});
</script>
