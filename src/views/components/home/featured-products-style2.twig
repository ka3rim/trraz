{# TERAZ 2.0 — Salla Product Component Bridge #}
{% set prods = [] %}
{% for p in products|default(component.products|default([])) %}
  {% set prods = prods|merge([{
    id: p.id,
    sku: p.sku,
    name: p.name,
    url: p.url,
    price: p.price ? (p.price|money) : 0,
    status: p.status|default('sale'),
    is_available: p.is_available is defined ? (p.is_available ? true : false) : (p.status|default('sale') != 'out'),
    is_out_of_stock: p.is_out_of_stock|default(false),
    quantity: p.quantity is defined ? p.quantity : null,
    type: p.type|default('product'),
    image: p.image.url|default('')
  }]) %}
{% endfor %}
{% for sec in items|default([]) %}
  {% for p in sec.products|default([]) %}
    {% set prods = prods|merge([{
      id: p.id,
      sku: p.sku,
      name: p.name,
      url: p.url,
      price: p.price ? (p.price|money) : 0,
      status: p.status|default('sale'),
      is_available: p.is_available is defined ? (p.is_available ? true : false) : (p.status|default('sale') != 'out'),
      is_out_of_stock: p.is_out_of_stock|default(false),
      quantity: p.quantity is defined ? p.quantity : null,
      type: p.type|default('product'),
      image: p.image.url|default('')
    }]) %}
  {% endfor %}
{% endfor %}
{% if prods|length %}
<script>window.TERAZ_QUEUE_OVERRIDE({ sallaProducts: {{ prods|json_encode|raw }} });</script>
{% endif %}
