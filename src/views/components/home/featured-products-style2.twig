{# TERAZ 2.0 — Salla Product Component Bridge #}
{% set prods = [] %}
{% for p in products|default(component.products|default([])) %}
  {% set prods = prods|merge([{
    id: p.id,
    sku: p.sku,
    name: p.name,
    url: p.url,
    price: p.price ? (p.price|money) : 0,
    image: p.image.url|default('')
  }]) %}
{% endfor %}
{% for sec in items|default([]) %}
  {% for p in sec.products|default([]) %}
    {% set prods = prods|merge([{
      id: p.id,
      sku: p.sku,
      name: p.name,
      url: p.url,
      price: p.price ? (p.price|money) : 0,
      image: p.image.url|default('')
    }]) %}
  {% endfor %}
{% endfor %}
{% if prods|length %}
<script>window.TERAZ_QUEUE_OVERRIDE({ sallaProducts: {{ prods|json_encode|raw }} });</script>
{% endif %}
