{# TERAZ 2.0 — Enhanced Slider (home.enhanced-slider) #}
{% set raed_dummies = ['MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH', '3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K', 'D7bG3pgSit43TheOejBOZV7LIfG1y1Cj0hWLmgIh', 'pzOCEw10wCfXeVSpKnL0Ifd1O9ZkTfnZ17RkE14R', 'lkyDjYwvWJNmAQoGnLALLcUkm66rCCDbTyVlSGdH'] %}
{% set valid_slides = [] %}
{% for slide in component.slides|default([]) %}
  {% set u = slide.image|default('') %}
  {% set is_dummy = false %}
  {% for h in raed_dummies %}{% if h in u %}{% set is_dummy = true %}{% endif %}{% endfor %}
  {% if u and not is_dummy %}{% set valid_slides = valid_slides|merge([slide]) %}{% endif %}
{% endfor %}
{% if valid_slides|length %}
<section component-id="{{ componentId }}" data-testid="store-home-slider" class="teraz-custom-slider">
  <div class="teraz-slider-track">
    {% for slide in valid_slides %}
      <div class="teraz-slider-slide">
        <img src="{{ slide.image }}" alt="{{ slide.title|default('طراز') }}" loading="lazy" width="1360" height="500">
        {% if slide.title or slide.description %}
          <div class="teraz-banner-caption">
            {% if slide.title %}<h3>{{ slide.title }}</h3>{% endif %}
            {% if slide.description %}<p>{{ slide.description }}</p>{% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}
