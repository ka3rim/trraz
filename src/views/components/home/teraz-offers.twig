{#
  TERAZ 2.0 — قسم العروض والباقات (home.teraz-offers)
#}
{% set c = component|default({}) %}
{% set offers_ovr = {
  offersTitle: c.title|default(''),
  offersSub: c.text|default(''),
  offers: {
    single: c.offer_single_image|default(''),
    starter: c.offer_starter_image|default(''),
    pair2: c.offer_pair2_image|default('')
  }
} %}
<script>
window.TERAZ_QUEUE_OVERRIDE({{ offers_ovr|json_encode|raw }});
</script>
