{# Quiet band (.quiet-band) shown after the socks strip. #}
{% set c = component|default({}) %}
<section class="quiet-band">
  <h3>{{ c.title|default('حتى التفاصيل اللي ما تبان كثير، تفرق.') }}</h3>
  <p>{{ c.text|default('قرّب لون الشراب من الجزمة أو البنطلون، وخلّ الإطلالة تمتد بهدوء.') }}</p>
</section>
