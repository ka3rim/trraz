{# TERAZ 2.0 — Enhanced Square Banners (home.enhanced-square-banners) #}
{% set raed_dummies = ['MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH', '3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K', 'D7bG3pgSit43TheOejBOZV7LIfG1y1Cj0hWLmgIh', 'pzOCEw10wCfXeVSpKnL0Ifd1O9ZkTfnZ17RkE14R', 'lkyDjYwvWJNmAQoGnLALLcUkm66rCCDbTyVlSGdH'] %}
{% set valid_banners = [] %}
{% for banner in component.banners|default([]) %}
  {% set u = banner.image|default('') %}
  {% set is_dummy = false %}
  {% for h in raed_dummies %}{% if h in u %}{% set is_dummy = true %}{% endif %}{% endfor %}
  {% if u and not is_dummy %}{% set valid_banners = valid_banners|merge([banner]) %}{% endif %}
{% endfor %}
{% if valid_banners|length %}
<section component-id="{{ componentId }}" data-testid="store-home-square-banners" class="teraz-custom-banners-grid">
  <div class="teraz-banners-row">
    {% for banner in valid_banners %}
      <a href="{{ banner.url|default('#knit') }}" class="teraz-banner-card">
        <img src="{{ banner.image }}" alt="{{ banner.title|default('طراز') }}" loading="lazy">
        {% if banner.title or banner.description %}
          <div class="teraz-banner-caption">
            {% if banner.title %}<h3>{{ banner.title }}</h3>{% endif %}
            {% if banner.description %}<p>{{ banner.description }}</p>{% endif %}
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}
