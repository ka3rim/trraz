{% extends "layouts.master" %}
{% set home_url = store.url|default('/') %}
{% block content %}
<div class="teraz teraz-subpage teraz-customer-layout">
  <div class="product-breadcrumb">
    <a href="{{ home_url }}">→ العودة إلى الرئيسية</a>
    <span>طراز / حسابي / {{ page.title }}</span>
  </div>

  <section class="section">
    <header class="section-heading">
      <div>
        <span class="eyebrow">حساب العميل في طراز</span>
        <h1>{{ page.title }}</h1>
      </div>
    </header>

    <div class="teraz-customer-grid">
      <nav aria-label="Sidebar" class="teraz-customer-sidebar sidebar">
        {% if is_page('customer.profile') %}
          <div class="teraz-avatar-box">
            <div class="h-20 w-20 m-auto avatar-wrap rounded-full">
              <salla-file-upload data-testid="store-profile-avatar-upload" profile-image value="{{ user.avatar }}">
                <span class="avatar-placeholder flex justify-center items-center flex-col">
                  <span class="sicon-user"></span>
                  <span class="text">{{ trans('common.uploader.choose_suitable_picture') }}</span>
                </span>
              </salla-file-upload>
            </div>
          </div>
        {% endif %}
        <div class="teraz-user-menu-wrap">
          <salla-user-menu data-testid="store-sidebar-user-menu" inline></salla-user-menu>
        </div>
      </nav>

      <div class="teraz-panel teraz-customer-main main-content">
        {% block inner_title %}{% endblock %}
        {% block inner_content %}{% endblock %}
      </div>
    </div>
  </section>
</div>
{% endblock %}
