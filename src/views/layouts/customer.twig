{#
  TERAZ 2.0 Customer Layout (src/views/layouts/customer.twig)
  Strictly follows Salla Twilight Documentation for Customer Account Pages
#}
{% extends 'layouts.master' %}
{% block body_class %}teraz-customer-page{% endblock %}
{% block content %}
  <div class="teraz-subpage teraz-customer-layout" data-testid="store-customer-layout">
    <header class="teraz-subpage-header">
      <div>
        <nav class="breadcrumbs w-full pb-2">
          <salla-breadcrumb data-testid="store-breadcrumb"></salla-breadcrumb>
        </nav>
        <div class="flex items-center gap-3">
          <h1 class="teraz-subpage-title">{{ page.title }}</h1>
          {% hook 'customer:profile.header.end' %}
        </div>
      </div>
      <a href="{{ store.url|default('/') }}" class="secondary">← العودة للمتجر</a>
    </header>

    <div class="teraz-customer-grid">
      <aside class="teraz-customer-sidebar">
        <div class="teraz-customer-card">
          <salla-user-menu inline data-testid="store-customer-menu"></salla-user-menu>
        </div>
      </aside>
      <div class="teraz-customer-main">
        {% block inner_content %}{% endblock %}
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'customer.js' | asset }}"></script>
{% endblock %}
