#}
{% set home_url = store.url|default('/') %}
{% set teraz_logo_url = theme.settings.get('teraz_logo')|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/logo.webp') %}
{% set teraz_config = {
  threshold: theme.settings.get('teraz_free_shipping_threshold')|default(449),
  shippingFee: theme.settings.get('teraz_shipping_fee')|default(29),
  categoryIds: theme.settings.get('teraz_category_ids')|default([]),
  productMap: theme.settings.get('teraz_product_map')|default(''),
  storePayments: store.settings.payments|default([]),
  homeUrl: home_url,
  assetsBase: 'https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/',
