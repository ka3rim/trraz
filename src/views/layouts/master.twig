  <header class="site-header">
    <button type="button" class="menu-btn" data-action="menu" aria-label="افتح القائمة">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
    </button>
    <a class="brand" href="#home" aria-label="{{ store.name|default('طراز') }}، الصفحة الرئيسية">
      <img src="{{ teraz_logo_url }}" width="42" height="32" alt="">
      <span>طراز<small>TERAZ</small></span>
    </a>
    <nav class="main-nav" aria-label="التنقل الرئيسي">
      <button type="button" class="nav-link" data-mega="shoes" aria-expanded="false">الأحذية <i aria-hidden="true">⌄</i></button>
      <button type="button" class="nav-link" data-mega="more" aria-expanded="false">كمّل كشختك <i class="nav-new">جديد</i> <i aria-hidden="true">⌄</i></button>
      <button type="button" class="nav-link" data-mega="offers" aria-expanded="false">العروض <i aria-hidden="true">⌄</i></button>
      <button type="button" class="nav-link" data-action="size-guide">المقاسات</button>
    </nav>
    <div class="header-actions">
      {% if user.type == 'user' %}
        <div class="header-user-menu"><salla-user-menu avatar-only show-header data-testid="store-user-menu"></salla-user-menu></div>
      {% else %}
        <button type="button" class="header-login-btn" data-testid="store-login-btn" data-action="login" onclick="window.salla && salla.event && salla.event.dispatch('login::open')" aria-label="{{ trans('blocks.header.login')|default('تسجيل الدخول') }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.8-3.6 5-5.5 8-5.5s6.2 1.9 8 5.5"/></svg>
          <span>{{ trans('blocks.header.login')|default('دخول') }}</span>
        </button>
      {% endif %}
      <button type="button" class="cart-trigger" data-action="cart" aria-label="افتح السلة">
        <svg width="22" height="24" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="M4 8h16l1 16H3L4 8Z" stroke="currentColor"/><path d="M8 9V5a4 4 0 0 1 8 0v4" stroke="currentColor"/></svg>
        <span>السلة</span><b id="cart-count">{{ cart.count|default(0) }}</b><em id="cart-sum"></em>
      </button>
    </div>
    <div class="mega" id="mega" hidden></div>
  </header>

  <main id="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <div class="sticky-buy" id="sticky-buy" hidden>
    <div><strong id="sticky-name"></strong><span id="sticky-price"></span></div>
    <button type="button" class="primary" data-action="sticky-add">أضف للسلة</button>
  </div>
  <a href="#knit" class="mobile-shop">اختر جزمتك <span>من 319 ريال ←</span></a>
  <a class="whatsapp-float" id="whatsapp-float" href="https://wa.me/+966570442661" target="_blank" rel="noopener" data-action="whatsapp" aria-label="كلمنا واتساب">
    <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.8 1 3.9.8a3.3 3.3 0 0 0 2.1-1.5 2.7 2.7 0 0 0 .2-1.5c-.1-.2-.3-.3-.6-.4Z"/></svg>
    <span>تبي مساعدة؟</span>
  </a>

  <footer>
    <div class="footer-brand"><a class="brand" href="#home">طراز <small>TERAZ</small></a><p>{{ theme.settings.get('teraz_footer_tagline')|default('راحة تليق بالمقام.') }}</p></div>
    <nav class="footer-links" aria-label="روابط تهمك">
      <a href="#guarantee">التبديل والإرجاع</a>
      <a href="#questions">التوصيل والأسئلة</a>
      <button type="button" class="text-button" data-action="size-guide">جدول المقاسات</button>
    </nav>
    <div class="footer-pay"><small>تقدر تدفع بـ</small><div class="pay-chips" id="footer-pay"></div><div class="salla-native-payments"><salla-payments data-testid="store-footer-payments"></salla-payments><salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges></div></div>
    <div class="footer-legal" id="footer-legal"></div>
    {% hook 'footer:end' %}
  </footer>

  <dialog id="cart-dialog" class="cart-dialog" aria-labelledby="bag-title">
    <header><h2 id="bag-title">سلتك</h2><button type="button" data-action="close-cart" aria-label="سكّر السلة">×</button></header>
    <div id="cart-body" aria-live="polite"></div>
  </dialog>

  <dialog id="menu-dialog" class="menu-dialog" aria-label="القائمة">
    <div class="menu-head"><a class="brand" href="#home"><img src="{{ teraz_logo_url }}" width="34" height="26" alt=""> طراز <small>TERAZ</small></a><button type="button" data-action="close-menu" aria-label="سكّر القائمة">×</button></div>
    <div id="menu-body"></div>
  </dialog>

  <dialog id="size-dialog" class="size-dialog" aria-labelledby="size-title">
    <button type="button" class="close" data-action="close-size" aria-label="سكّر">×</button>
    <h2 id="size-title">اعرف مقاسك في دقيقة.</h2>
    <div id="size-guide-body"></div>
  </dialog>

  <dialog id="notes-dialog" class="notes-dialog" aria-labelledby="notes-title">
    <button type="button" class="close" data-action="close-notes" aria-label="سكّر">×</button>
    <h2 id="notes-title">عن متجر طراز</h2>
    <p>تجربة تسوق متكاملة مربوطة ببوابة الدفع والشحن في سلة.</p>
  </dialog>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
  <salla-search data-testid="store-search-modal"></salla-search>
  <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
  {% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
  {% endif %}

  <script defer crossorigin="anonymous" src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/app.js"></script>
