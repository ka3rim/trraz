<body id="app" class="teraz-body {% hook 'body:classes' %} {% block body_class %}{% endblock %}">
  {% hook 'body:start' %}

  {# TERAZ global header: logo, anchor/category navigation, cart trigger (#cart-count is driven by Salla cart events). #}
{% set home_url = store.url|default('/') %}
{% set logo = theme.settings.get('teraz_logo')|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/logo.webp') %}
<div class="teraz">
  <a class="skip" href="#main">انتقل إلى المحتوى</a>
  <header class="site-header">
    <a class="brand" href="{{ home_url }}" aria-label="{{ store.name|default('طراز') }} — الرئيسية">
      <img src="{{ logo }}" width="42" height="32" alt="">
      <span>طراز<small>TERAZ</small></span>
    </a>
    <nav aria-label="التنقل الرئيسي">
      <a href="{{ home_url }}#knit">مجموعة الأناقة</a>
      <a href="{{ home_url }}#caps">كمّل كشختك</a>
      <a href="{{ home_url }}#care">العناية بالجزم</a>
      <a href="{{ home_url }}#why">ليش طراز؟</a>
    </nav>
    <button type="button" class="cart-trigger" data-action="cart" aria-label="فتح حقيبتك" aria-haspopup="dialog" aria-controls="cart-dialog">
      <svg width="22" height="24" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="M4 8h16l1 16H3L4 8Z" stroke="currentColor"/><path d="M8 9V5a4 4 0 0 1 8 0v4" stroke="currentColor"/></svg>
      <span>حقيبتك</span>
      <b id="cart-count">0</b>
    </button>
  </header>
</div>


  <main id="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <div class="teraz">
    {# Mobile sticky shop bar — shown on the home page only (CSS: body:not(.teraz-home)). #}
    <a href="{{ home_url }}#knit" class="mobile-shop">اختر جزمتك <span>←</span></a>
  </div>

  {# TERAZ global footer. The prototype's sandbox disclosure is intentionally gone: this theme runs on live Salla commerce. #}
{% set home_url = store.url|default('/') %}
<div class="teraz">
  <footer class="site-footer">
    <a class="brand" href="{{ home_url }}">طراز <small>TERAZ</small></a>
    <p>{{ theme.settings.get('teraz_footer_tagline')|default('راحة تليق بالمقام.') }}</p>
    <a href="{{ home_url }}#guarantee">الاسترجاع والاستبدال</a>
    <a href="{{ home_url }}#questions">الشحن والأسئلة الشائعة</a>
  </footer>
</div>


  <div class="teraz">
    {# Slide-over bag: stage 1 "bag", stage 2 ".is-review". Rendered by teraz-salla-controller.js from salla.cart. #}
    <dialog id="cart-dialog" class="cart-dialog" aria-labelledby="bag-title">
      <header>
        <div>
          <span class="eyebrow">على طرازك</span>
          <h2 id="bag-title">حقيبتك</h2>
        </div>
        <button type="button" data-action="close-cart" aria-label="إغلاق الحقيبة">×</button>
      </header>
      <div id="cart-body" aria-live="polite"></div>
    </dialog>

    {# popover="manual" lifts the toast above the modal dialog's top layer when supported. #}
    <div id="toast" class="toast" role="status" aria-live="polite" popover="manual"></div>
  </div>

  {# Required by Salla for guest-only actions (wishlist, restock notice for registered users, checkout login). #}
  <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
  <salla-search data-testid="store-search-modal"></salla-search>
  <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
  {% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
  {% endif %}

  <script defer crossorigin="anonymous" src="{{ 'app.js'|asset }}"></script>
  <script>window.TERAZ_SALLA_CONFIG = {{ teraz_config|json_encode|raw }};</script>
  <script>
/**
 * TERAZ (طراز) — rich catalog metadata, sort ranks and pairing engine.
 *
 * Source of truth for every piece of TERAZ copy that Salla's product record cannot hold:
 * group, headline, colour, styling, materials, fit, care, pairing and the three sort ranks
 * (thobe / casual / walking) for the 22 products of the prototype (catalog.js).
 *
 * This file is DATA + PURE LOGIC only. It never touches the DOM and never calls Salla.
 * Mapping a Salla product (id / sku / url / name) to a TERAZ id lives in salla-metadata-config.js.
 * Prices here are display fall-backs only; the live Salla price always wins.
