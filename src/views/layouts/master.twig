function normalizeArabic(s) {
  return String(s || '').trim().toLowerCase()
    .replace(/[\u064B-\u065F\u0670\u0640]/g, '')
    .replace(/[أإآ]/g, 'ا')
    .replace(/ة/g, 'ه')
    .replace(/ى/g, 'ي')
    .replace(/\s+/g, ' ');
}

function syncSallaPayments(rawList) {
  if (!Array.isArray(rawList) || !rawList.length) return false;
  const resolved = [];
  rawList.forEach(item => {
    if (!item) return;
    const rawStr = typeof item === 'string' ? item.trim() : String(item.id || item.code || item.name || '').trim();
    if (!rawStr) return;
    const key = rawStr.toLowerCase();
    const norm = normalizeArabic(rawStr);
    const match = ALL_SALLA_PAYMENT_METHODS.find(m =>
      m.id === key ||
      m.sallaKeys.includes(key) ||
      normalizeArabic(m.chip) === norm ||
      normalizeArabic(m.label) === norm
    );
    const entry = match || {
      id: key,
      sallaKeys: [key],
      chip: rawStr,
      label: rawStr,
      badge: rawStr.toUpperCase(),
      desc: 'الدفع الإلكتروني الآمن عبر بوابة سلة'
    };
    if (!resolved.some(r => r.id === entry.id)) resolved.push(entry);
  });
  if (!resolved.length) return false;
  SALLA_PAYMENT_METHODS = resolved;
  CFG.payments = SALLA_PAYMENT_METHODS.map(m => m.chip);
  if (!SALLA_PAYMENT_METHODS.some(m => m.id === selectedPaymentMethod)) {
    selectedPaymentMethod = SALLA_PAYMENT_METHODS[0].id;
  }
  if (Array.isArray(faqs) && faqs[3]) {
    faqs[3][1] = (CFG.payments || []).join('، ') + '.';
  }
  if ($('#footer-pay')) $('#footer-pay').innerHTML = payChips();
  if ($('#trust')) renderTrust();
  if ($('#faq')) $('#faq').innerHTML = faqHTML(faqs);
  if (view === 'lp' && $('.lp-view .questions > div:last-child')) {
    $('.lp-view .questions > div:last-child').innerHTML = faqHTML(faqs.slice(0, 4));
  }
  $$('[data-panel] .pay-chips').forEach(el => { el.innerHTML = payChips(); });
  $$('[data-panel] .assurances').forEach(el => { el.innerHTML = assurances({ compact: true }); });
  if ($('#cart-dialog')?.open) {
    renderCart($('#cart-dialog').dataset.stage || 'bag');
  }
  return true;
}

window.TERAZ_SET_PAYMENT_METHODS = function(list) {
  return syncSallaPayments(list);
};

function parseSallaPrice(val, fallback) {
  if (typeof val === 'number' && Number.isFinite(val) && val > 0) return val;
  if (val && typeof val === 'object') {
    const sub = val.amount ?? val.value ?? val.price;
    if (sub !== undefined) return parseSallaPrice(sub, fallback);
    return fallback;
  }
  if (typeof val === 'string') {
    const cleaned = val.replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/[^0-9.]/g, '');
    const n = parseFloat(cleaned);
    if (Number.isFinite(n) && n > 0) return n;
  }
  return fallback;
}

function isSallaProductAvailable(sallaProd) {
  if (!sallaProd || typeof sallaProd !== 'object') return true;
  if (sallaProd.inStock === false || sallaProd.in_stock === false) return false;
  if (sallaProd.is_available === false || sallaProd.is_available === 0 || sallaProd.is_available === '0' || sallaProd.is_available === 'false') return false;
  if (sallaProd.is_out_of_stock === true || sallaProd.is_out_of_stock === 1 || sallaProd.is_out_of_stock === '1') return false;
  const st = String(sallaProd.status || '').toLowerCase().trim();
  if (st === 'out' || st === 'out-of-stock' || st === 'out_of_stock' || st === 'unavailable' || st === 'hidden' || st === 'deleted') return false;
  if (typeof sallaProd.quantity === 'number' && sallaProd.quantity <= 0 && sallaProd.unlimited_quantity !== true && sallaProd.is_infinite_quantity !== true) return false;
  return true;
}

function parseProductMapConfig() {
  const raw = window.TERAZ_SALLA_CONFIG && window.TERAZ_SALLA_CONFIG.productMap;
  if (!raw) return {};
  if (typeof raw === 'object') return raw;
  if (typeof raw === 'string') {
    const trimmed = raw.trim();
    if (!trimmed) return {};
    try { return JSON.parse(trimmed); } catch {}
    const out = {};
    trimmed.split(/[\r\n,;]+/).forEach(line => {
      const m = line.split(/[:=]/);
      if (m.length >= 2) out[m[0].trim()] = m[1].trim();
    });
    return out;
  }
  return {};
}

function matchCatalogTargets(sallaProd) {
  if (!sallaProd) return [];
  const sku = String(sallaProd.sku || '').trim().toLowerCase();
  if (sku) {
    if (sku === 'socks') return catalog.filter(p => p.group === 'socks');
    const bySku = catalog.find(p => p.id.toLowerCase() === sku);
    if (bySku) return [bySku];
  }
  const mapCfg = parseProductMapConfig();
  if (mapCfg && typeof mapCfg === 'object' && sallaProd.id !== undefined) {
    const matchedByMap = [];
    for (const [terazId, sallaId] of Object.entries(mapCfg)) {
      if (String(sallaId).trim() === String(sallaProd.id).trim()) {
        if (terazId === 'socks') matchedByMap.push(...catalog.filter(p => p.group === 'socks'));
        else {
          const found = byId(terazId);
          if (found) matchedByMap.push(found);
        }
      }
    }
    if (matchedByMap.length) return matchedByMap;
  }
  const normName = normalizeArabic(sallaProd.name);
  if (normName) {
    const exactOrSub = catalog.find(p =>
      normalizeArabic(p.name) === normName ||
      normalizeArabic((p.family || '') + ' ' + p.color) === normName ||
      normName.includes(normalizeArabic(p.name))
    );
    if (exactOrSub) return [exactOrSub];

    if (normName.includes('تنظيف') || normName.includes('عده التنظيف') || normName.includes('فوم')) return [byId('cleaning-kit')].filter(Boolean);
    if (normName.includes('عزل') || normName.includes('بخاخ')) return [byId('water-shield')].filter(Boolean);
    if (normName.includes('طقم العنايه') || normName.includes('مجموعه العنايه')) return [byId('care-pack')].filter(Boolean);
    if (normName.includes('ضي البدر')) return [byId('badr')].filter(Boolean);
    if (normName.includes('دفء العود')) return [byId('oud')].filter(Boolean);
    if (normName.includes('رمل الدهناء')) return [byId('dahna')].filter(Boolean);
    if (normName.includes('هيل القهوه')) return [byId('coffee')].filter(Boolean);

    const byFamily = catalog.filter(p => p.family && (normalizeArabic(p.family) === normName || normName.includes(normalizeArabic(p.family))));
    if (byFamily.length) return byFamily;
    if (normName === 'شرابات' || normName === 'شراب' || normName === 'جوارب') return catalog.filter(p => p.group === 'socks');
  }
  return [];
}

function matchCatalogProduct(sallaProd) {
  return matchCatalogTargets(sallaProd)[0] || null;
}

