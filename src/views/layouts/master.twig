  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{% block title %}{{ page.title|default(store.name|default('طراز | راحة تليق بالمقام')) }}{% endblock %}</title>
  {% block meta %}
