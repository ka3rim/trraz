{#
  TERAZ (طراز) — master layout for theme-raed.

  Everything TERAZ draws lives inside a `.teraz` wrapper so atelier-salla.css never leaks into
  Salla's own components (login modal, checkout widgets, other Raed pages).

  Child templates may override:  title · meta · head_scripts · styles · body_class · content · scripts
#}
{% set home_url = store.url|default('/') %}
{% set est = theme.settings.get('teraz_show_shipping_estimate') %}
{# Shipping estimate defaults to ON; only an explicit "off" in the theme settings hides it. #}
{% set show_estimate = true %}
{% if est is defined and est is not null and not est %}{% set show_estimate = false %}{% endif %}
{% set teraz_config = {
  threshold: theme.settings.get('teraz_free_shipping_threshold')|default(479),
  shippingFee: theme.settings.get('teraz_shipping_fee')|default(29),
  showShippingEstimate: show_estimate,
  categoryIds: theme.settings.get('teraz_category_ids')|default([]),
  productMap: theme.settings.get('teraz_product_map')|default(''),
  homeUrl: home_url
} %}
<!DOCTYPE html>
<html lang="{{ language.code|default('ar') }}" dir="{{ theme.is_rtl is defined and not theme.is_rtl ? 'ltr' : 'rtl' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}{{ page.title|default(store.name) }}{% endblock %}</title>
  {% block meta %}
  <meta name="description" content="{{ page.description|default('تجربة طراز المستقلة. اكتشف الأحذية المحاكة وتنسيقات الكابات والشرابات وخف الكشخة.') }}">
  {% endblock %}
  {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

  {% block head_scripts %}{% endblock %}
  {% hook 'head:start' %}
  {% hook 'head' %}
  {% block styles %}{% endblock %}

  <script>document.documentElement.classList.add('teraz-js');</script>

  {# Fatimah — redeclared here with Salla's asset URL so the font resolves regardless of the CSS build path. #}
  <link rel="preload" as="font" type="font/otf" crossorigin href="{{ 'fonts/Fatimah-400.otf'|asset }}">
  <style>
    @font-face{font-family:Fatimah;src:url('{{ 'fonts/Fatimah-400.otf'|asset }}') format('opentype');font-weight:400;font-display:swap}
    @font-face{font-family:Fatimah;src:url('{{ 'fonts/Fatimah-700.otf'|asset }}') format('opentype');font-weight:700;font-display:swap}
  </style>
  <link rel="stylesheet" href="{{ 'app.css'|asset }}">
  <link rel="stylesheet" href="{{ 'atelier-salla.css'|asset }}">

  {% hook 'head:end' %}
</head>
<body id="app" class="teraz-body {% hook 'body:classes' %} {% block body_class %}{% endblock %}">
  {% hook 'body:start' %}

  {% include 'components.header' %}

  <main id="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <div class="teraz">
    {# Mobile sticky shop bar — shown on the home page only (CSS: body:not(.teraz-home)). #}
    <a href="{{ home_url }}#knit" class="mobile-shop">اختر جزمتك <span>←</span></a>
  </div>

  {% include 'components.footer' %}

  <div class="teraz">
    {# Slide-over bag: stage 1 "bag", stage 2 ".is-review". Rendered by teraz-salla-controller.js from salla.cart. #}
    <dialog id="cart-dialog" class="cart-dialog" aria-labelledby="bag-title">
      <header>
        <div>
          <span class="eyebrow">على طرازك</span>
          <h2 id="bag-title">حقيبتك</h2>
        </div>
        <button type="button" data-action="close-cart" aria-label="إغلاق الحقيبة">×</button>
      </header>
      <div id="cart-body" aria-live="polite"></div>
    </dialog>

    {# popover="manual" lifts the toast above the modal dialog's top layer when supported. #}
    <div id="toast" class="toast" role="status" aria-live="polite" popover="manual"></div>
  </div>

  {# Required by Salla for guest-only actions (wishlist, restock notice for registered users, checkout login). #}
  <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
  <salla-search data-testid="store-search-modal"></salla-search>
  <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
  {% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
  {% endif %}

  <script defer crossorigin="anonymous" src="{{ 'app.js'|asset }}"></script>
  <script>window.TERAZ_SALLA_CONFIG = {{ teraz_config|json_encode|raw }};</script>
  <script defer src="{{ 'teraz-catalog-map.js'|asset }}"></script>
  <script defer src="{{ 'salla-metadata-config.js'|asset }}"></script>
  <script defer src="{{ 'teraz-salla-controller.js'|asset }}"></script>
  {% block scripts %}{% endblock %}

  {% hook 'body:end' %}
</body>
</html>
