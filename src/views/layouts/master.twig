/* =====================================================================
   TERAZ 2 — conversion and UI/UX layer (overrides the base styles above)
   ===================================================================== */
:root{--accent:#6f5638;--good:#3f6b45;--good-bg:#e7efe2;--radius:10px;--shadow:0 10px 30px #3a2a1a14;--header-h:68px}
body{font-size:17px;-webkit-font-smoothing:antialiased}
.visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sandbox{font-size:11px;gap:12px;padding:5px 16px}

/* Header: sticky, compact */
.site-header{position:sticky;top:0;z-index:30;padding:12px 5vw;background:#fcfaf4ee;backdrop-filter:saturate(1.2) blur(10px);-webkit-backdrop-filter:blur(10px)}
.site-header nav{gap:28px;align-items:center}
.site-header nav a,.nav-link{font-size:15px;position:relative;padding:4px 0}
.site-header nav a:hover,.nav-link:hover{color:var(--accent)}
.nav-link{font-size:15px}
.cart-trigger{border:1px solid var(--line);padding:8px 14px;border-radius:999px;background:var(--white)}
.cart-trigger b{background:var(--ink);color:var(--white);min-width:22px;text-align:center}
.lp-mode .site-header nav,.lp-mode .mobile-shop,.lp-mode .collection-nav{display:none!important}

/* Buttons */
.primary,.secondary{border-radius:var(--radius);gap:18px;transition:background .2s,transform .1s}
.primary:active,.secondary:active{transform:scale(.98)}
.secondary{border-color:#cdbda3}
.secondary:hover{background:var(--cream)}
.primary.small,.secondary.small{padding:7px 14px;font-size:14px;gap:8px}
.link-button{font-size:13px;text-decoration:underline;text-underline-offset:4px;color:var(--accent)}

/* Hero */
.hero-sub{font-size:21px;margin:10px 0 6px;color:#6b5640}
.hero-price{font-size:17px;color:var(--ink);margin:0 0 16px;display:flex;justify-content:center;align-items:center;gap:12px;flex-wrap:wrap}
.hero-price b{font-weight:400;font-size:22px}
.hero-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.hero-actions .primary,.hero-actions .secondary{font-size:15px;padding:11px 24px}
.hero-actions .secondary{background:#fffdf8cc}
.rating-line{display:inline-flex;align-items:center;gap:6px;font-size:14px;color:var(--ink)}
.rating-line span{color:var(--muted)}
.rating-line.small{font-size:13px;margin:4px 0 2px}
.stars{color:#b08a3e;letter-spacing:1px}

/* Trust strip */
.trust-strip{background:var(--ink);color:#f6efe2}
.trust-strip ul{list-style:none;margin:0;padding:16px 5vw;display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.trust-strip li{display:flex;align-items:center;gap:10px;font-size:14px;line-height:1.5}
.trust-strip svg{flex-shrink:0;color:#d9c29a}
.lp-band{margin-top:0}

/* Collection nav */
.collection-nav{grid-template-columns:repeat(6,1fr);padding:18px 5vw}
.collection-nav a{font-size:17px;transition:color .2s}
.collection-nav a:hover{color:var(--accent)}

/* Product cards */
.product-card{flex-basis:calc((100% - 66px)/4)}
.product-image{border-radius:var(--radius)}
.product-image img.is-photo{object-fit:cover}
.card-meta h3{font-size:21px;margin:2px 0 10px}
.card-color{font-size:12px!important}
.card-bottom{align-items:center}
.card-price{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.card-price b{font-size:17px;font-weight:400;color:var(--ink)}
.card-price s{font-size:13px;color:var(--muted)}
.card-price .deal{font-size:11px;color:var(--good);background:var(--good-bg);padding:1px 7px;border-radius:999px}
.card-add{font-size:13px;border:1px solid var(--ink);padding:6px 14px;border-radius:999px;white-space:nowrap}
.card-add:hover{background:var(--ink);color:var(--white)}
.sort-bar button{border-radius:999px}

/* Offers */
.section-heading.center{justify-content:center;text-align:center}
.section-heading.center p{margin-inline:auto}
.offers{background:#f4eee2;border-top:1px solid var(--line)}
.offer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;max-width:1150px;margin:0 auto}
.offer-card{position:relative;display:flex;flex-direction:column;gap:8px;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:22px;text-align:right;transition:transform .2s,box-shadow .2s;font:inherit;color:inherit;cursor:pointer}
.offer-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.offer-card.featured{border:2px solid var(--ink);box-shadow:var(--shadow)}
.offer-tag{position:absolute;top:-12px;right:20px;background:var(--ink);color:var(--white);font-size:12px;padding:3px 12px;border-radius:999px}
.offer-image{aspect-ratio:4/3;background:linear-gradient(160deg,#f6f0e5,#ece2d1);border-radius:10px;overflow:hidden;margin-bottom:6px}
.offer-image img{width:100%;height:100%;object-fit:contain;padding:12px}
.offer-card h3{font-size:24px}
.offer-card p{font-size:14px;min-height:42px}
.offer-price{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.offer-price strong{font-size:28px;font-weight:400}
.offer-price s{color:var(--muted);font-size:15px}
.offer-price em,.save{font-style:normal;font-size:13px;color:var(--good);background:var(--good-bg);padding:2px 9px;border-radius:999px}
.free-ship{font-size:13px;color:var(--good)}
.ship-fee{font-size:13px;color:var(--muted)}
.offer-cta{margin-top:auto;padding-top:10px;font-size:15px;border-top:1px solid var(--line)}

/* New line feature */
.new-line{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:6vw;padding:70px 8vw;background:#ebe4d8}
.new-line-image img{width:100%;border-radius:16px;box-shadow:var(--shadow)}
.badge-new{display:inline-block;background:#8a5a2b;color:#fff;font-size:12px;padding:3px 12px;border-radius:999px;margin-bottom:14px}
.new-line-copy h2{margin-bottom:14px}
.new-line-copy>p{font-size:18px;max-width:460px}
.new-line-price{color:var(--ink)!important;margin:16px 0!important;font-size:16px!important}
.new-line-swatches{display:flex;gap:12px;margin-bottom:24px}
.new-line-swatches a{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:12px}
.new-line-swatches img{width:72px;height:72px;object-fit:cover;border-radius:10px;border:1px solid var(--line)}
.new-line-swatches a:hover img{border-color:var(--ink)}

/* Reviews */
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.review-card{background:var(--white);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.review-card img{width:100%;aspect-ratio:4/3;object-fit:cover}
.review-card>div{padding:18px}
.review-card p{color:var(--ink);font-size:15px;margin:8px 0}
.fit-bar{min-width:240px;font-size:13px}
.fit-bar>div{display:flex;height:6px;border-radius:999px;overflow:hidden;background:#e5dccd;margin:6px 0}
.fit-bar i{display:block;background:#d2c3a8}
.fit-bar i.ok{background:var(--good)}

/* Why */
.why{display:grid;grid-template-columns:1fr 1.6fr;gap:6vw;align-items:start;border-top:1px solid var(--line)}
.why .lead{font-size:19px;margin-top:16px}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.why-grid article{border-top:2px solid var(--ink);padding-top:16px}
.why-grid small{font:11px Arial;color:var(--bronze)}
.why-grid h3{font-size:21px;margin:6px 0}
.why-grid p{font-size:15px}
.occasion-section{grid-template-columns:1fr 1fr}
.occasion-card{border-radius:14px}
.occasion-card>span small{display:block;font-size:13px;color:var(--muted)}
.occasion-card>span b{font-size:20px;margin-top:2px}
.occasion-card img.is-photo{object-fit:cover;border-radius:10px}

/* Accessories tabs */
.accessories{border-top:1px solid var(--line)}
.tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin-bottom:10px;padding-bottom:4px}
.tabs::-webkit-scrollbar{display:none}
.tabs button{flex-shrink:0;padding:8px 18px;border:1px solid var(--line);border-radius:999px;font-size:15px;scroll-margin-top:calc(var(--header-h) + 20px)}
.tabs button[aria-selected=true]{background:var(--ink);color:var(--white);border-color:var(--ink)}
.tab-note{font-size:14px;margin-bottom:22px;min-height:24px}

/* Guarantee / FAQ / closing */
.guarantee-facts strong{font-size:56px}
.side-help{margin-top:16px;font-size:15px}
.side-help a{text-decoration:underline;color:var(--accent)}
.closing p{max-width:460px;margin:-16px auto 22px}
.lead-form{display:flex;gap:10px;justify-content:center;max-width:440px;margin:0 auto}
.lead-form input{flex:1;min-width:0;border:1px solid #cdbda3;border-radius:var(--radius);padding:12px 14px;background:var(--white);color:var(--ink);font-size:16px}
.lead-message{font-size:14px;margin-top:12px;min-height:22px}

/* Footer */
footer{display:grid;grid-template-columns:1.2fr 1.5fr 1fr;align-items:start;gap:30px;border-top:1px solid var(--line);padding:40px 5vw 110px}
.footer-brand p{font-size:14px;margin-top:8px}
.footer-links{display:flex;flex-direction:column;gap:8px;font-size:14px;align-items:flex-start}
.footer-links .text-button{text-decoration:none;font-size:14px}
.footer-pay small{display:block;color:var(--muted);margin-bottom:8px}
.footer-legal{grid-column:1/-1;display:flex;gap:20px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.footer-legal:empty{display:none}
.pay-chips{display:flex;flex-wrap:wrap;gap:6px}
.pay-chip{font:12px/1 Arial,sans-serif;border:1px solid var(--line);background:var(--white);padding:6px 9px;border-radius:6px;color:var(--ink)}

/* Floating WhatsApp + sticky buy bar */
.whatsapp-float{position:fixed;left:18px;bottom:22px;z-index:25;display:flex;align-items:center;gap:8px;background:#1f7a4d;color:#fff;padding:10px 16px 10px 12px;border-radius:999px;box-shadow:0 8px 24px #0002;font-size:14px;transition:bottom .25s}
.whatsapp-float.demo{opacity:.92}
body:has(.sticky-buy.show) .whatsapp-float{bottom:96px}
body:has(dialog[open]) .whatsapp-float{display:none}
.sticky-buy{position:fixed;bottom:0;left:0;right:0;z-index:26;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 5vw calc(12px + env(safe-area-inset-bottom));background:#fffdf8f5;backdrop-filter:blur(10px);border-top:1px solid var(--line);box-shadow:0 -8px 24px #3a2a1a14;transform:translateY(110%);transition:transform .25s}
.sticky-buy.show{transform:none}
.sticky-buy>div{display:flex;flex-direction:column;line-height:1.35;min-width:0}
.sticky-buy strong{font-weight:400;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sticky-buy span{font-size:14px;color:var(--ink)}
.sticky-buy s{color:var(--muted);font-size:12px}
.sticky-buy .primary{padding:11px 22px;font-size:15px;flex-shrink:0}
body:has(dialog[open]) .sticky-buy{display:none}

/* Image placeholder */
.img-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;width:100%;height:100%;min-height:120px;background:repeating-linear-gradient(135deg,#efe7d8 0 12px,#ebe2d1 12px 24px);color:var(--muted);text-align:center;padding:10px}
.img-placeholder span{font-size:16px;color:var(--ink)}

/* Product page */
.pdp-mode .mobile-shop{display:none!important}
.product-breadcrumb{padding:18px 5vw}
.product-layout{grid-template-columns:1.1fr 1fr;gap:5vw;align-items:start}
.product-gallery{top:calc(var(--header-h) + 16px)}
.primary-photo{border-radius:16px}
.primary-photo.photo>img{object-fit:cover}
.primary-photo.photo{background:#ece5d9}
.gallery-thumbs{display:flex;gap:10px;margin-top:12px}
.gallery-thumbs button{width:76px;height:76px;border-radius:10px;overflow:hidden;border:2px solid transparent;padding:0;background:#efe8dc}
.gallery-thumbs button[aria-pressed=true]{border-color:var(--ink)}
.gallery-thumbs img{width:100%;height:100%;object-fit:cover}
.purchase-panel>.eyebrow{margin-bottom:8px}
.purchase-panel h1{font-size:44px;line-height:1.2}
.color-line{font-size:16px;margin-top:4px}
.price-line{margin:14px 0 6px;flex-wrap:wrap;gap:12px}
.price-line strong{font-size:32px}
.price-line s{font-size:17px;color:var(--muted)}
.field-label{display:flex;justify-content:space-between;align-items:center;width:100%;font-size:15px;color:var(--ink);margin:18px 0 10px;padding:0}
.field-label small{color:var(--muted);font-size:12px}
.swatches{display:grid;grid-template-columns:repeat(8,1fr);gap:8px}
.swatches.few{grid-template-columns:repeat(4,1fr)}
.swatch{display:flex;flex-direction:column;align-items:center;gap:3px;padding:0;font:inherit;background:none;border:0;cursor:pointer}
.swatch img{width:100%;aspect-ratio:1;object-fit:contain;background:#f1eadf;border-radius:10px;border:2px solid transparent;transition:border-color .15s}
.swatch img.is-photo{object-fit:cover}
.swatch span{font-size:10px;color:var(--muted);text-align:center;line-height:1.3;display:none}
.swatch[aria-pressed=true] img,.swatch[aria-current=true] img{border-color:var(--ink)}
.swatch:hover img{border-color:#bca684}
.offers-picker{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.offer-option{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:12px;padding:12px 14px;cursor:pointer;background:var(--white);transition:border-color .15s,box-shadow .15s}
.offer-option:hover{border-color:#bca684}
.offer-option.selected{border:2px solid var(--ink);padding:11px 13px;box-shadow:var(--shadow)}
.offer-option input{accent-color:var(--ink);width:18px;height:18px;flex-shrink:0}
.offer-main{display:flex;flex-direction:column;flex:1;line-height:1.4}
.offer-main b{font-weight:400;font-size:17px}
.offer-main small{font-size:12px;color:var(--muted)}
.offer-side{display:flex;flex-direction:column;align-items:flex-end;line-height:1.35;text-align:left}
.offer-side strong{font-weight:400;font-size:18px}
.offer-side s{font-size:12px;color:var(--muted)}
.offer-side em{font-style:normal;font-size:11px;color:var(--good)}
.sizes{margin:6px 0 0}
.sizes>div{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin:0}
.sizes button{border-radius:10px;padding:11px 0;min-width:0;background:var(--white)}
.sizes button:hover{border-color:var(--ink)}
.one-size-note{font-size:14px;margin:16px 0 4px}
.pair2-extra{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px;padding:14px;background:var(--cream);border:1px solid var(--line);border-radius:14px}
.pair2-extra .field-label{margin-top:0}
.pair2-extra .swatch img{background:var(--white)}
.pair2-extra .sizes{margin:0}
.pair2-extra label{display:flex;flex-direction:column;gap:4px;font-size:13px}
.pair2-extra select,.quick-size{border:1px solid #cdbda3;border-radius:8px;padding:8px;background:var(--white);color:var(--ink);font-size:14px}
.add-main{display:flex;width:100%;padding:15px 22px;font-size:17px;margin-top:4px}
.ship-status{font-size:13px;margin:8px 0 14px;color:var(--good)}
.assurances{list-style:none;padding:14px 0;margin:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;gap:8px}
.assurances li{display:flex;gap:10px;align-items:center;font-size:14px;color:var(--ink)}
.assurances svg{color:var(--bronze);flex-shrink:0}
.purchase-panel .pay-chips{margin:14px 0 6px}
.help-line{font-size:13px;margin-top:8px}
.help-line a{color:var(--accent);text-decoration:underline}
.product-details{display:grid;grid-template-columns:1fr 1fr;gap:6vw;border-top:1px solid var(--line)}
.product-story h2{font-size:34px;margin-bottom:12px}
.product-story p{margin:12px 0 0}
.complete-look{background:#f1eadf}
.look-heading{margin-bottom:28px}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:1150px;margin:0 auto}
.quick-item{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:10px}
.quick-photo{display:block;aspect-ratio:4/3;background:#f4eee4;border-radius:8px;overflow:hidden}
.quick-photo img{width:100%;height:100%;object-fit:contain}
.quick-photo img.is-photo{object-fit:cover}
.quick-item h4{font-size:16px;line-height:1.4}
.quick-price{display:flex;gap:6px;align-items:baseline;flex-wrap:wrap;font-size:15px;color:var(--ink);margin:4px 0}
.quick-price b{font-weight:400}
.quick-price s{font-size:12px;color:var(--muted)}
.quick-price small{font-size:11px;color:var(--good)}
.quick-item .quick-size{width:100%;margin-bottom:8px}
.quick-item .secondary{width:100%;justify-content:center}
.match-feedback{font-size:12px;color:var(--good);margin-top:4px;min-height:16px}
.alternatives{border-top:1px solid var(--line)}

/* Cart */
.cart-dialog{padding:22px 24px}
.shipping-progress{border-radius:10px;font-size:14px}
.shipping-progress b{font-weight:400;color:var(--ink)}
.upsell{display:flex;align-items:center;gap:12px;border:1px dashed var(--bronze);border-radius:12px;padding:10px 12px;margin-bottom:12px;background:#fffaf0}
.upsell img{width:64px;height:52px;object-fit:contain}
.upsell>div{flex:1;display:flex;flex-direction:column;line-height:1.4}
.upsell b{font-weight:400;font-size:15px}
.upsell small{font-size:12px;color:var(--muted)}
.cart-line{grid-template-columns:96px 1fr}
.line-visual{position:relative;width:96px;height:80px;background:#f2ebdf;border-radius:10px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.line-visual img{width:100%;height:100%;object-fit:contain}
.line-visual img.is-photo{object-fit:cover}
.line-visual.pair img{position:absolute;width:75%;height:70%}
.line-visual.pair img:first-child{top:2px;right:2px}
.line-visual.pair img:last-child{bottom:2px;left:2px}
.line-visual.starter span{position:absolute;bottom:4px;left:4px;background:var(--ink);color:#fff;font:11px Arial;padding:2px 6px;border-radius:999px}
.cart-line h3{font-size:17px;line-height:1.4}
.cart-line p{font-size:12px}
.line-price{margin-top:4px}
.line-price s{font-size:12px;color:var(--muted)}
.cart-recommend h3{font-size:20px;margin-bottom:12px}
.quick-grid.compact{grid-template-columns:repeat(3,1fr);gap:10px}
.quick-grid.compact .quick-item{padding:10px;gap:6px}
.quick-grid.compact h4{font-size:13px}
.quick-grid.compact .secondary{font-size:12px;padding:6px}
.cart-summary .savings strong,.cart-summary .savings span{color:var(--good)}
.summary-note{font-size:12px!important;color:var(--muted)!important;display:block!important;margin:8px 0}
.cart-summary .pay-chips{margin:6px 0 4px}
.cart-summary>.primary{border-radius:var(--radius)}
.cart-summary>small{text-align:center;margin-top:8px}
.message-preview p{font-size:14px}

/* Size dialog */
.size-dialog{width:min(560px,94vw);padding:32px;border-radius:16px}
.size-dialog .close{float:left;font-size:30px}
.size-dialog h2{font-size:28px;margin-bottom:16px}
.size-guide table{width:100%;border-collapse:collapse;font-size:15px;margin-bottom:16px}
.size-guide th{font-weight:400;color:var(--muted);text-align:right;padding:8px;border-bottom:1px solid var(--line)}
.size-guide td{padding:9px 8px;border-bottom:1px solid var(--line)}
.size-guide tbody tr:nth-child(odd){background:#f6f1e8}
.measure-steps{padding-right:20px;margin:0 0 12px;font-size:15px;color:var(--muted)}
.measure-steps b{font-weight:400;color:var(--ink)}
.size-tip{font-size:14px;color:var(--good)}

/* Landing pages */
.lp-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:4vw;padding:28px 5vw 48px;align-items:start}
.lp-visual{position:sticky;top:calc(var(--header-h) + 16px);aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:#f3ebdc}
.lp-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.65}
.lp-shoe{position:absolute;inset:8%;display:flex;align-items:center;justify-content:center}
.lp-shoe img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 18px 14px #402d1730)}
.lp-shoe img.is-photo{object-fit:cover;border-radius:14px;filter:none}
.lp-title{font-size:clamp(34px,3.4vw,52px);line-height:1.25;color:var(--ink)}
.lp-sub{font-size:18px;margin:8px 0 6px;max-width:520px}
.lp-mode .purchase-panel>.eyebrow{display:none}
.lp-mode .purchase-panel h1{font-size:26px;margin-top:14px}
.lp-occasion{padding-top:20px}
.lp-size{display:grid;grid-template-columns:1fr 1.3fr;gap:6vw;border-top:1px solid var(--line)}
.lp-guarantee{text-align:center;background:#e8ddc8}
.lp-guarantee p{max-width:560px;margin:10px auto 0}
.lp-guarantee a{text-decoration:underline}
.lp-final.center{text-align:center}
.lp-final.center h2{margin-bottom:20px}

/* Laptop refinements */
@media(min-width:1001px){
  .product-card{flex-basis:calc((100% - 66px)/4)}
  .purchase-panel{max-width:560px}
}

/* Tablet */
@media(max-width:1000px){
  .trust-strip ul{grid-template-columns:repeat(2,1fr)}
  .collection-nav{grid-template-columns:repeat(3,1fr)}
  .offer-grid{grid-template-columns:1fr 1fr 1fr;gap:14px}
  .why{grid-template-columns:1fr}
  .quick-grid{grid-template-columns:repeat(2,1fr)}
  .lp-hero{grid-template-columns:1fr 1fr}
  .swatches{grid-template-columns:repeat(4,1fr)}
  .swatch span{display:block}
  footer{grid-template-columns:1fr 1fr}
}

/* Mobile */
@media(max-width:640px){
  :root{--header-h:58px}
  body{font-size:16px}
  .site-header{padding:10px 5vw}
  .cart-trigger{padding:6px 12px}
  .cart-trigger span{display:none}
  .hero-wording{padding:22px 6vw 14px}
  .hero-wording h1{font-size:36px}
  .hero-sub{font-size:16px!important;margin:6px 0 4px!important}
  .hero-price{font-size:15px;margin-bottom:12px}
  .hero-actions{gap:8px}
  .hero-actions .primary,.hero-actions .secondary{font-size:14px;padding:10px 18px;flex:1;justify-content:center;max-width:200px}
  .atelier-stage{aspect-ratio:1/.82}
  .trust-strip ul{grid-template-columns:1fr 1fr;gap:10px 14px;padding:14px 6vw}
  .trust-strip li{font-size:12px;gap:8px}
  .trust-strip svg{width:18px;height:18px}
  .collection-nav{display:flex;overflow-x:auto;gap:8px;padding:12px 6vw;scrollbar-width:none}
  .collection-nav::-webkit-scrollbar{display:none}
  .collection-nav a{flex-shrink:0;border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:14px}
  .collection-nav span{display:none}
  .product-card{flex-basis:72%}
  .card-meta h3{font-size:19px}
  .offer-grid{display:flex;flex-direction:column;gap:18px}
  .offer-card{display:grid;grid-template-columns:110px 1fr;column-gap:14px;row-gap:4px;padding:16px;align-items:start}
  .offer-card .offer-image{grid-row:1/6;margin:0;aspect-ratio:1}
  .offer-card h3{font-size:20px}
  .offer-card p{min-height:0;font-size:13px}
  .offer-price strong{font-size:22px}
  .offer-cta{grid-column:1/-1}
  .new-line{grid-template-columns:1fr;padding:44px 6vw;gap:24px}
  .new-line-copy h2 br{display:none}
  .review-grid{grid-template-columns:1fr}
  .why-grid{grid-template-columns:1fr;gap:16px}
  .occasion-section{grid-template-columns:1fr 1fr;padding:24px 6vw}
  .occasion-card>span b{font-size:15px}
  .tabs button{font-size:14px;padding:7px 14px}
  .lead-form{flex-direction:column}
  footer{grid-template-columns:1fr;gap:22px;padding:30px 6vw 120px}
  .whatsapp-float{left:12px;bottom:16px;padding:10px}
  .whatsapp-float span{display:none}
  body:has(.sticky-buy.show) .whatsapp-float{bottom:86px}
  body:has(.mobile-shop) #home-view:not([hidden]) ~ .whatsapp-float{bottom:70px}
  .sticky-buy{padding:10px 5vw calc(10px + env(safe-area-inset-bottom))}
  .sticky-buy .primary{padding:11px 16px;font-size:14px}
  .product-breadcrumb{padding:12px 6vw}
  .product-layout{gap:20px}
  .primary-photo{aspect-ratio:1.15;border-radius:12px}
  .primary-photo.photo{aspect-ratio:1}
  .gallery-thumbs button{width:62px;height:62px}
  .purchase-panel h1{font-size:34px}
  .price-line strong{font-size:28px}
  .swatches{grid-template-columns:repeat(4,1fr);gap:6px}
  .swatches.few{grid-template-columns:repeat(3,1fr)}
  .offer-option{padding:10px 12px;gap:10px}
  .offer-option.selected{padding:9px 11px}
  .offer-main b{font-size:16px}
  .sizes>div{gap:6px}
  .pair2-extra{grid-template-columns:1fr}
  .product-details{grid-template-columns:1fr;gap:20px}
  .product-story h2{font-size:28px}
  .quick-grid{grid-template-columns:1fr 1fr;gap:10px}
  .quick-item{padding:10px}
  .quick-item h4{font-size:14px}
  .quick-grid.compact{grid-template-columns:1fr 1fr 1fr}
  .cart-dialog{padding:18px 16px}
  .cart-line{grid-template-columns:84px 1fr}
  .line-visual{width:84px;height:72px}
  .size-dialog{padding:22px}
  .lp-hero{grid-template-columns:1fr;padding:0 0 30px;gap:0}
  .lp-visual{position:relative;top:auto;aspect-ratio:1.25;border-radius:0}
  .lp-copy{padding:20px 6vw 0}
  .lp-title{font-size:32px}
  .lp-sub{font-size:16px}
  .lp-size{grid-template-columns:1fr;gap:16px}
  .guarantee-facts strong{font-size:44px}
}

/* fixes after visual review */
.occasion-card img,.new-line-image img,.lp-occasion img{height:auto}
.occasion-card img{aspect-ratio:1.5;object-fit:contain}
@media(min-width:641px){
  .exhibit{top:calc(36% + var(--tier)*27%);height:26%}
  .hero-wording{top:22px}
  footer{padding-bottom:50px}
}
@media(min-width:641px) and (max-width:1000px){
  .exhibit{top:calc(42% + var(--tier)*27%);height:24%}
  .atelier-stage{aspect-ratio:1.3}
}
@media(max-width:640px){
  .new-line-image img{aspect-ratio:1.35;object-fit:cover;width:100%}
  .occasion-card img{aspect-ratio:1.2}
}
img{height:auto}
.product-details .product-story{display:block}
.product-details .product-story .eyebrow{margin-bottom:8px}
@media(max-width:640px){
  .product-layout{grid-template-columns:1fr;padding:0 6vw 30px}
  .product-gallery{position:static}
}
.sizes legend .link-button{border:0;padding:0;background:none;min-width:0;font:13px Fatimah,Tahoma,sans-serif;border-radius:0}
@media(max-width:640px){
  .primary-photo{aspect-ratio:1.4}
  .swatches,.swatches.few{display:flex;overflow-x:auto;gap:8px;scrollbar-width:none;padding-bottom:4px;margin-inline:-6vw;padding-inline:6vw}
  .swatches::-webkit-scrollbar{display:none}
  .swatch{flex:0 0 70px}
  .swatch span{display:block;font-size:10px}
  .pair2-extra{padding:12px}
  .pair2-extra .swatches{margin-inline:0;padding-inline:0}
}
.lp-hero>*,.product-layout>*,.purchase-panel{min-width:0}
.lp-shoe:has(img.is-photo){inset:0}
.lp-shoe img.is-photo{border-radius:0;width:100%;height:100%}
@media(max-width:640px){.lp-visual{aspect-ratio:1.6}}

/* =====================================================================
   TERAZ 2.1 — warm layer: coffee and sand, human rhythm, equal categories
   ===================================================================== */
:root{--ivory:#fbf7ef;--cream:#f3e9d8;--sand:#efe3cf;--sand-2:#e6d6bb;--ink:#33261b;--coffee:#7a5232;--bronze:#8f6b45;--muted:#7a6a5a;--line:#e5d8c3;--white:#fffcf6;--good:#466b3f;--good-bg:#e8efdf}
body{background:var(--ivory);color:var(--ink)}
p{color:var(--muted)}
h2{text-wrap:balance}
.section-heading h2{font-size:clamp(32px,3.2vw,48px)}
.section-heading p{font-size:18px;max-width:620px}
.eyebrow{letter-spacing:0;font-size:13px;color:var(--coffee)}
.sandbox{background:#ebe0cc;color:#6f604f}
.nav-new{font-style:normal;font-size:11px;background:var(--coffee);color:#fff;padding:1px 7px;border-radius:999px;margin-right:4px;vertical-align:2px}
.primary{background:var(--ink);border-color:var(--ink)}
.primary:hover{background:var(--coffee);border-color:var(--coffee)}

/* trust strip: warm, not dark */
.trust-strip{background:var(--sand);color:var(--ink);border-bottom:1px solid var(--line)}
.trust-strip svg{color:var(--coffee)}
.trust-strip li{font-size:15px}

/* quick category links (mobile) */
.quick-nav{display:none}

/* need finder */
.needs{padding-bottom:40px}
.needs-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.need-card{display:flex;flex-direction:column;gap:6px;background:var(--white);border:1px solid var(--line);border-radius:16px;padding:12px 12px 16px;transition:border-color .2s,transform .2s}
.need-card:hover{border-color:var(--coffee);transform:translateY(-3px)}
.need-image{aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:linear-gradient(160deg,#f6eee0,#ebdfca);margin-bottom:6px}
.need-image img{width:100%;height:100%;object-fit:contain;padding:8px}
.need-image img.is-photo{object-fit:cover;padding:0}
.need-card h3{font-size:22px;color:var(--ink)}
.need-card p{font-size:14px;line-height:1.6;flex:1}
.need-card>span{font-size:14px;color:var(--coffee);margin-top:6px}

/* collection */
.collection{background:var(--ivory)}
.sort-bar button{font-size:15px}

/* why TERAZ */
.why{grid-template-columns:1fr 1.05fr;align-items:center;background:var(--cream);border-top:0}
.why-copy h2{margin-bottom:12px}
.why .lead,.lp-why .lead{font-size:20px;line-height:1.85;color:#5d4c3c;max-width:560px}
.why-facts{list-style:none;padding:0;margin:22px 0 20px;display:grid;gap:14px}
.why-facts li{font-size:16px;color:var(--muted);padding-right:16px;border-right:2px solid var(--sand-2)}
.why-facts b{display:block;font-weight:400;font-size:19px;color:var(--ink)}
.why-facts.wide{grid-template-columns:repeat(3,1fr);gap:24px;margin-top:20px}
.compare{background:var(--white);border:1px solid var(--line);border-radius:18px;padding:10px 14px;font-size:15px}
.compare-row{display:grid;grid-template-columns:1.1fr 1fr 1fr 1.15fr;align-items:center;border-bottom:1px solid var(--line)}
.compare-row:last-child{border-bottom:0}
.compare-row>span{padding:14px 10px;color:var(--muted);line-height:1.4}
.compare-row>span[role=rowheader]{color:var(--ink)}
.compare-head>span{font-size:13px;padding-block:10px}
.compare .ours{background:var(--sand);color:var(--ink)}
.compare-head .ours{border-radius:12px 12px 0 0;font-size:17px;color:var(--coffee)}
.compare-row:last-child .ours{border-radius:0 0 12px 12px}

/* offers */
.offers{background:var(--ivory);border-top:0}
.offer-card{background:var(--white);border-radius:18px}
.offer-card.featured{border:2px solid var(--coffee)}
.offer-card p{font-size:15px}
.offer-save{color:var(--good)!important;font-size:14px!important;min-height:0!important;margin:0}
.offer-cta{color:var(--coffee)}

/* every accessory category gets its own showcase */
.accessories{background:var(--ivory)}
#category-rows{display:grid;gap:70px;margin-top:10px}
.category-block{display:grid;grid-template-columns:1.1fr 1fr;grid-template-areas:"feature copy" "grid grid";gap:28px 5vw;align-items:center}
.category-block.flip{grid-template-columns:1fr 1.1fr;grid-template-areas:"copy feature" "grid grid"}
.category-block.is-new{background:var(--cream);border-radius:24px;padding:32px}
.category-feature{grid-area:feature;aspect-ratio:16/10;border-radius:20px;overflow:hidden;background:radial-gradient(ellipse at 50% 45%,#faf3e7,#eadcc5)}
.category-feature img{width:100%;height:100%;object-fit:contain;padding:6%}
.category-feature.photo img{object-fit:cover;padding:0}
.category-copy{grid-area:copy;display:flex;flex-direction:column;align-items:flex-start;gap:10px}
.category-copy h3{font-size:clamp(30px,2.8vw,42px);line-height:1.25}
.category-copy p{font-size:18px;line-height:1.85;max-width:500px}
.category-copy .category-price{color:var(--ink);font-size:16px}
.category-copy .primary{margin-top:6px}
.badge-new{background:var(--coffee);margin-bottom:0}
.category-grid{grid-area:grid;display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.category-grid .product-card{flex:none;min-width:0}
.product-image{background:linear-gradient(160deg,#f7efe2,#ece0cc)}

/* cards a touch warmer */
.card-add{border-color:var(--ink)}
.card-add:hover{background:var(--coffee);border-color:var(--coffee)}
.card-price .deal{color:var(--good)}

/* guarantee, FAQ, closing */
.guarantee{background:var(--sand)}
.guarantee-facts strong{color:var(--coffee)}
.questions h2{margin-bottom:8px}
.journal{background:var(--cream)}
.journal h2{margin-bottom:10px}
.closing{background:var(--sand-2)}
.closing h2{margin-bottom:22px}

/* product page warmth */
.offer-option.selected{border-color:var(--coffee)}
.swatch[aria-pressed=true] img,.swatch[aria-current=true] img{border-color:var(--coffee)}
.ship-status{color:var(--good)}
.complete-look{background:var(--cream)}
.look-heading p{margin-top:6px}
.lp-why{background:var(--cream)}
.lp-why.why{display:grid}

@media(max-width:1000px){
  .needs-grid{grid-template-columns:repeat(3,1fr)}
  .why{grid-template-columns:1fr}
  .category-block,.category-block.flip{grid-template-columns:1fr 1fr;grid-template-areas:"feature copy" "grid grid"}
  .category-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:640px){
  .quick-nav{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:12px 6vw;border-bottom:1px solid var(--line);background:var(--ivory)}
  .quick-nav::-webkit-scrollbar{display:none}
  .quick-nav a{flex-shrink:0;border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:14px;background:var(--white)}
  .section-heading p{font-size:16px}
  .needs-grid{display:flex;overflow-x:auto;gap:12px;margin-inline:-6vw;padding:0 6vw 6px;scrollbar-width:none;scroll-snap-type:x mandatory}
  .needs-grid::-webkit-scrollbar{display:none}
  .need-card{flex:0 0 62%;scroll-snap-align:start}
  .need-card h3{font-size:20px}
  .why-facts.wide{grid-template-columns:1fr}
  .compare{font-size:13px;padding:6px 8px}
  .compare-row{grid-template-columns:1fr 1fr 1fr 1.1fr}
  .compare-row>span{padding:11px 6px}
  .compare-head .ours{font-size:15px}
  #category-rows{gap:48px}
  .category-block,.category-block.flip{grid-template-columns:1fr;grid-template-areas:"feature" "copy" "grid";gap:18px}
  .category-block.is-new{padding:18px;margin-inline:-2vw}
  .category-feature{aspect-ratio:16/11}
  .category-copy p{font-size:16px}
  .category-grid{grid-template-columns:1fr 1fr;gap:14px}
  .category-grid .card-meta h3{font-size:16px;margin-bottom:8px}
  .category-grid .card-bottom{flex-direction:column;align-items:stretch;gap:8px}
  .category-grid .card-add{text-align:center}
  .category-grid .card-price{justify-content:flex-start}
}

/* categories: stacked vertically on home, each opens its own collection page */
#category-rows{gap:22px}
.category-block,.category-block.flip{grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-areas:"feature copy";gap:0;background:var(--white);border:1px solid var(--line);border-radius:20px;overflow:hidden;align-items:stretch}
.category-block.flip{grid-template-areas:"copy feature"}
.category-block.is-new{background:var(--cream);padding:0}
.category-feature{display:block;aspect-ratio:auto;min-height:300px;border-radius:0}
.category-copy{padding:34px 4vw;justify-content:center}
.category-copy h3{font-size:clamp(28px,2.6vw,38px)}
.category-copy p{font-size:17px}
.category-peek{display:flex;gap:8px;margin:4px 0}
.category-peek a{width:64px;height:52px;border-radius:10px;background:#f2e8d8;overflow:hidden;border:1px solid var(--line)}
.category-peek img{width:100%;height:100%;object-fit:contain}
.category-peek img.is-photo{object-fit:cover}
.category-peek a:hover{border-color:var(--coffee)}

/* full collection page */
.collection-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:4vw;align-items:center;padding:6px 5vw 10px}
.collection-hero-image{aspect-ratio:16/10;border-radius:22px;overflow:hidden;background:radial-gradient(ellipse at 50% 45%,#faf3e7,#eadcc5)}
.collection-hero-image img{width:100%;height:100%;object-fit:contain;padding:6%}
.collection-hero.photo .collection-hero-image img{object-fit:cover;padding:0}
.collection-hero-copy h1{font-size:clamp(38px,4vw,58px);line-height:1.2;margin:6px 0 12px}
.collection-hero-copy p{font-size:18px;line-height:1.85;max-width:520px}
.collection-hero-copy .category-price{color:var(--ink);margin-top:10px}
.collection-page{padding-top:30px}
.collection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
.collection-grid .product-card{flex:none;min-width:0}
.collection-note{margin-top:18px;font-size:15px;color:var(--good)}
.pairs-with{background:var(--cream)}
.pairs-with h2{margin-bottom:6px}
.pairs-with>p{margin-bottom:22px}
.pairs-with .secondary{margin-top:6px}
.other-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:20px}
.other-card{display:flex;flex-direction:column;gap:4px;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:10px 10px 14px}
.other-card img{aspect-ratio:4/3;width:100%;object-fit:cover;border-radius:10px;background:#f2e8d8}
.other-card span{font-size:18px}
.other-card small{color:var(--muted)}
.other-card:hover{border-color:var(--coffee)}

@media(max-width:1000px){
  .collection-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:640px){
  .category-block,.category-block.flip{grid-template-columns:1fr;grid-template-areas:"feature" "copy"}
  .category-block.is-new{margin-inline:0}
  .category-feature{min-height:0;aspect-ratio:16/10}
  .category-copy{padding:20px 18px 24px}
  .category-copy .primary{align-self:stretch;justify-content:space-between}
  .category-peek a{width:56px;height:46px}
  .collection-hero{grid-template-columns:1fr;padding:0 6vw}
  .collection-hero-copy h1{font-size:36px}
  .collection-hero-copy p{font-size:16px}
  .collection-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .collection-grid .card-meta h3{font-size:16px;margin-bottom:8px}
  .collection-grid .card-bottom{flex-direction:column;align-items:stretch;gap:8px}
  .collection-grid .card-add{text-align:center}
  .other-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:640px){
  .trust-strip li{font-size:12.5px;line-height:1.45;text-wrap:balance}
  body:has(#home-view:not([hidden])) .whatsapp-float{bottom:74px}
}

/* ---------- needs as a table ---------- */
.needs-table{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--white)}
.needs-row{display:grid;grid-template-columns:1fr 1.5fr 2fr 90px;align-items:center;gap:18px;padding:14px 22px;border-bottom:1px solid var(--line);transition:background .15s}
.needs-row:last-child{border-bottom:0}
a.needs-row:hover{background:var(--cream)}
.needs-head{background:var(--sand);font-size:14px;color:var(--muted);padding-block:10px}
.needs-where{font-size:21px;color:var(--ink)}
.needs-pick{display:flex;align-items:center;gap:12px;font-size:16px;color:var(--ink);line-height:1.4}
.needs-pick small{display:block;color:var(--muted);font-size:13px}
.needs-thumbs{display:flex;flex-shrink:0}
.needs-thumbs img{width:62px;height:50px;object-fit:contain;background:#f2e8d8;border-radius:10px;border:2px solid var(--white)}
.needs-thumbs img.is-photo{object-fit:cover}
.needs-thumbs img+img{margin-inline-start:-16px}
.needs-why{font-size:15px;color:var(--muted);line-height:1.7}
.needs-go{color:var(--coffee);font-size:15px;text-align:left}

/* ---------- interactive free-delivery bar ---------- */
.dbar{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:12px 14px 10px;margin:12px 0 14px}
.dbar-msg{font-size:14px;color:var(--ink);margin-bottom:10px}
.dbar-msg b{font-weight:400;color:var(--coffee)}
.dbar-track{position:relative;height:10px;border-radius:999px;background:#eadfcd;overflow:visible}
.dbar-now,.dbar-add{position:absolute;inset-block:0;inset-inline-start:0;border-radius:999px;transition:width .6s cubic-bezier(.2,.8,.2,1)}
.dbar-add{background:repeating-linear-gradient(-45deg,#c9a77e 0 6px,#d9bf9c 6px 12px);opacity:.9}
.dbar-now{background:var(--coffee);z-index:1}
.dbar-truck{position:absolute;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;background:var(--white);border:2px solid var(--coffee);color:var(--coffee);display:grid;place-items:center;z-index:2;transition:inset-inline-start .6s cubic-bezier(.2,.8,.2,1)}
.dbar-scale{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:10px}
.dbar.done .dbar-now,.dbar.done .dbar-add{background:var(--good)}
.dbar.done .dbar-truck{border-color:var(--good);color:var(--good);animation:dbar-pop .5s ease}
.dbar.done .dbar-msg b{color:var(--good)}
@keyframes dbar-pop{50%{transform:translateY(-50%) scale(1.18)}}
.dbar-nudge{display:flex;align-items:center;gap:10px;border:1px dashed var(--bronze);border-radius:12px;padding:8px 10px;margin:-4px 0 14px;background:#fffaf0;font-size:13px}
.dbar-nudge img{width:52px;height:42px;object-fit:contain}
.dbar-nudge span{flex:1;color:var(--ink)}
.dbar-nudge b{font-weight:400}
.cart-dialog .dbar{margin-top:0}

/* ---------- product previews ---------- */
.stage-tabs{display:flex;gap:6px;margin-bottom:10px;background:var(--sand);padding:4px;border-radius:999px;width:max-content;max-width:100%}
.stage-tabs button{padding:7px 16px;border-radius:999px;font-size:14px;color:var(--muted)}
.stage-tabs button[aria-selected=true]{background:var(--white);color:var(--ink);box-shadow:0 2px 8px #3a2a1a14}
.primary-photo.stage{aspect-ratio:auto;background:none;overflow:visible}
.scene{position:relative;aspect-ratio:1360/1220;border-radius:16px;overflow:hidden;background:#efe4d2}
.scene svg{position:absolute;inset:0;width:100%;height:100%}
.scene-shoe{position:absolute;inset-inline:0;top:24.59%;width:100%;height:85.25%;object-fit:contain}
.scene.is-clog .scene-shoe{height:81.15%}
.scene-front{z-index:2}
.stage-note{font-size:12px;color:var(--muted);text-align:center;margin-top:8px}
.stage-photo{position:relative;aspect-ratio:1360/1040;border-radius:16px;overflow:hidden;background:radial-gradient(ellipse at 50% 40%,#faf5eb,#ebe1d1)}
.stage-photo>img{width:100%;height:100%;object-fit:contain;transition:transform .35s}
.stage-photo.photo{aspect-ratio:1}
.stage-photo.photo>img{object-fit:cover}
.stage-photo.detail>img{transform:scale(1.8)}
.stage-photo.detail .hotspot{display:none}
.hotspot{position:absolute;width:30px;height:30px;margin:-15px 0 0 -15px;border-radius:50%;background:#fffcf6e6;border:2px solid var(--coffee);box-shadow:0 0 0 6px #7a523233;animation:hs-pulse 2.4s infinite;z-index:3}
.hotspot::after{content:'+';color:var(--coffee);font:18px/26px Arial}
.hotspot.open::after{content:'−'}
@keyframes hs-pulse{50%{box-shadow:0 0 0 12px #7a523200}}
.hotspot-tip{display:none;position:absolute;bottom:38px;left:50%;transform:translateX(-50%);width:200px;background:var(--white);border:1px solid var(--line);border-radius:12px;padding:10px 12px;font-size:13px;color:var(--muted);text-align:right;line-height:1.6;box-shadow:var(--shadow)}
.hotspot-tip b{display:block;font-weight:400;color:var(--ink);font-size:15px}
.hotspot.open .hotspot-tip,.hotspot:hover .hotspot-tip{display:block}
.shoe-picker{margin-top:12px}
.shoe-picker p{font-size:14px;color:var(--ink);margin-bottom:8px}
.shoe-picker>div{display:grid;grid-template-columns:repeat(8,1fr);gap:6px}
.shoe-picker button{aspect-ratio:1;border-radius:10px;background:#f2e8d8;border:2px solid transparent;padding:2px}
.shoe-picker button[aria-pressed=true]{border-color:var(--coffee)}
.shoe-picker img{width:100%;height:100%;object-fit:contain}
.look-flat{display:grid;grid-template-columns:1.2fr 1fr;grid-template-rows:1fr 1fr;gap:10px;aspect-ratio:1360/1040}
.look-flat>*{border-radius:14px;overflow:hidden;background:radial-gradient(ellipse at 50% 40%,#faf5eb,#ebe1d1);position:relative}
.look-cap{grid-row:1/3}
.look-flat img{width:100%;height:100%;object-fit:contain}
.look-flat a span{position:absolute;bottom:8px;inset-inline-start:10px;font-size:12px;background:#fffcf6e6;padding:2px 8px;border-radius:999px}
.lp-visual.staged{aspect-ratio:auto;background:none;overflow:visible;position:sticky}
.lp-visual.staged .product-gallery{position:static}

/* family cards: one product, its colours as small thumbs */
.card-dots{display:flex;gap:6px;margin-bottom:4px}
.card-dots a{width:34px;height:28px;border-radius:7px;overflow:hidden;background:#f2e8d8;border:1px solid var(--line)}
.card-dots img{width:100%;height:100%;object-fit:contain}
.card-dots img.is-photo{object-fit:cover}
.swatches.few{display:flex;flex-wrap:wrap;gap:8px}
.swatches.few .swatch{width:74px}
.swatches.few .swatch span{display:block}

/* TERAZ brand lines on the product page */
.brand-band{padding:46px 5vw;background:var(--ink);color:#f3e9d8;display:grid;gap:22px}
.brand-quote{font-size:clamp(26px,2.6vw,38px);color:#fbf3e4;line-height:1.4}
.brand-points{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.brand-points span{font-size:15px;color:#cdbfa8;line-height:1.7;border-top:1px solid #ffffff22;padding-top:12px}
.brand-points b{display:block;font-weight:400;font-size:19px;color:#fbf3e4}

@media(max-width:1000px){
  .needs-row{grid-template-columns:1fr 1.4fr 1.6fr 60px}
}
@media(max-width:640px){
  .needs-head{display:none}
  .needs-row{grid-template-columns:1fr auto;grid-template-areas:"where go" "pick pick" "why why";gap:8px 10px;padding:14px 16px}
  .needs-where{grid-area:where;font-size:19px}
  .needs-go{grid-area:go}
  .needs-pick{grid-area:pick;font-size:15px}
  .needs-why{grid-area:why;font-size:14px}
  .stage-tabs{width:100%}
  .stage-tabs button{flex:1;padding:7px 8px}
  .shoe-picker>div{grid-template-columns:repeat(4,1fr)}
  .hotspot-tip{width:170px}
  .brand-points{grid-template-columns:1fr}
  .brand-band{padding:34px 6vw}
  .lp-visual.staged{position:relative;top:auto;padding:12px 6vw 0}
}
.needs-grid{display:block!important;margin:0!important;padding:0!important;overflow:visible!important}

/* =====================================================================
   TERAZ 2.2 — navigation from anywhere, offer-aware photo, add-ons
   ===================================================================== */
.site-header{position:sticky;top:0;z-index:40}
.main-nav{display:flex;gap:6px;align-items:center}
.main-nav .nav-link{font-size:15px;padding:8px 12px;border-radius:999px;display:inline-flex;align-items:center;gap:6px;color:var(--ink)}
.main-nav .nav-link:hover,.main-nav .nav-link[aria-expanded=true]{background:var(--sand)}
.main-nav .nav-link>i[aria-hidden]{font-style:normal;font-size:12px;color:var(--muted);transform:translateY(-2px)}
.menu-btn{display:none;width:40px;height:40px;border-radius:12px;align-items:center;justify-content:center;color:var(--ink)}
.cart-trigger em{font-style:normal;font-size:13px;color:var(--coffee)}
.cart-trigger em:empty{display:none}
#cart-count.bump{animation:bump .45s ease}
@keyframes bump{40%{transform:scale(1.35)}}

/* mega menu (laptop) */
.mega{position:absolute;top:100%;inset-inline:0;background:var(--white);border-bottom:1px solid var(--line);box-shadow:0 18px 40px #3a2a1a1f;padding:22px 5vw 26px;animation:mega-in .18s ease}
@keyframes mega-in{from{opacity:0;transform:translateY(-6px)}}
.mega-inner{display:flex;gap:28px;align-items:flex-start}
.mega-grid{flex:1;display:grid;gap:12px}
.mega-grid.shoes{grid-template-columns:repeat(4,minmax(0,1fr))}
.mega-grid.more{grid-template-columns:repeat(5,minmax(0,1fr))}
.mega-grid.offers{grid-template-columns:repeat(3,minmax(0,1fr));max-width:900px}
.mega-grid a{display:flex;flex-direction:column;gap:2px;padding:8px;border-radius:14px;border:1px solid transparent}
.mega-grid a:hover{border-color:var(--line);background:var(--ivory)}
.mega-grid img{width:100%;aspect-ratio:4/3;object-fit:contain;background:#f3eadc;border-radius:10px;margin-bottom:6px}
.mega-grid img.is-photo{object-fit:cover}
.mega-grid b{font-weight:400;font-size:15px;color:var(--ink)}
.mega-grid small{font-size:12px;color:var(--muted)}
.mega-side{width:230px;display:flex;flex-direction:column;gap:10px;align-items:flex-start;padding:10px 0}
.mega-side h3{font-size:22px}
.mega-side p{font-size:14px}

/* mobile menu drawer */
.menu-dialog{margin:0 auto 0 0;inset-inline-start:auto;width:min(420px,92vw);height:100dvh;max-height:100dvh;padding:0;border-radius:0;overflow:auto;direction:rtl;background:var(--ivory)}
.menu-dialog[open]{animation:drawer-in .22s ease}
@keyframes drawer-in{from{transform:translateX(30px);opacity:.6}}
.menu-head{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--ivory);z-index:2}
.menu-head button{font-size:30px;line-height:1}
.menu-sec{padding:16px 0 6px;border-bottom:1px solid var(--line)}
.menu-sec-head{display:flex;justify-content:space-between;align-items:baseline;padding:0 18px 10px}
.menu-sec-head h3{font-size:20px}
.menu-sec-head a{font-size:13px;color:var(--coffee)}
.menu-row{display:flex;gap:10px;overflow-x:auto;padding:0 18px 12px;scrollbar-width:none}
.menu-row::-webkit-scrollbar{display:none}
.menu-row a{flex:0 0 112px;display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink);line-height:1.35}
.menu-row img{width:112px;height:86px;object-fit:contain;background:#f3eadc;border-radius:12px}
.menu-row img.is-photo{object-fit:cover}
.menu-links{display:flex;flex-direction:column;padding:10px 18px 30px}
.menu-links a,.menu-links button{padding:12px 0;border-bottom:1px solid var(--line);font-size:16px;text-align:right;color:var(--ink)}

/* photo follows the offer */
.stage-pair{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:0;padding:6% 3% 12%}
.stage-pair>div{position:relative}
.stage-pair img{width:100%;height:auto;object-fit:contain;filter:drop-shadow(0 12px 10px #402d1726)}
.stage-pair .pair-b{transform:translateY(14%)}
.stage-pair .pair-b img{transform:scaleX(-1)}
.stage-tag{position:absolute;bottom:12px;inset-inline-start:12px;background:#fffcf6e6;border:1px solid var(--line);font-size:13px;padding:3px 12px;border-radius:999px;color:var(--ink)}
.stage-extras{position:absolute;bottom:12px;inset-inline-end:12px;display:flex;align-items:center;gap:6px;background:#fffcf6eb;border:1px solid var(--line);border-radius:14px;padding:6px 8px;z-index:3;backdrop-filter:blur(4px)}
.stage-extras span{font-size:12px;color:var(--muted);padding-inline:2px 4px}
.stage-extras i{display:block;width:44px;height:38px;border-radius:9px;background:#f3eadc;overflow:hidden}
.stage-extras img{width:100%;height:100%;object-fit:contain}

/* كمّل كشختك inside the purchase panel */
.panel-addons{margin:4px 0 14px}
.panel-addons .field-label{margin-top:4px}
.addon-row{display:grid;gap:8px}
.addon{display:flex;align-items:center;gap:10px;background:var(--white);border:1px solid var(--line);border-radius:12px;padding:6px 8px}
.addon-img{width:56px;height:46px;flex-shrink:0;border-radius:9px;background:#f3eadc;overflow:hidden}
.addon-img img{width:100%;height:100%;object-fit:contain}
.addon-img img.is-photo{object-fit:cover}
.addon-info{flex:1;display:flex;flex-direction:column;line-height:1.35;min-width:0}
.addon-info a{font-size:15px;color:var(--ink)}
.addon-info span{font-size:13px;color:var(--muted)}
.addon-info b{font-weight:400;color:var(--ink)}
.addon-info s{font-size:12px}
.addon-btn{width:38px;height:38px;flex-shrink:0;border-radius:50%;border:1px solid var(--ink);display:grid;place-items:center;font-size:20px;color:var(--ink);transition:background .15s}
.addon-btn:hover{background:var(--ink);color:var(--white)}
.addon-btn.added{background:var(--good);border-color:var(--good);color:#fff;font-size:16px}
.addon-btn.link{font-size:16px}

/* bag: browse without leaving */
.cart-browse{border-top:1px solid var(--line);margin-top:18px;padding-top:14px}
.cart-browse p{font-size:14px;margin-bottom:8px;color:var(--ink)}
.cart-browse div{display:flex;flex-wrap:wrap;gap:8px}
.cart-browse a{border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:14px;background:var(--white)}
.cart-browse a:hover{border-color:var(--coffee)}

@media(max-width:1000px){
  .main-nav .nav-link{padding:8px 8px;font-size:14px}
  .mega-grid.more{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:640px){
  .site-header{gap:8px}
  .menu-btn{display:inline-flex}
  .main-nav{display:none}
  .brand{margin-inline-end:auto}
  .cart-trigger em{display:none}
  .mega{display:none}
  .stage-extras{bottom:8px;inset-inline-end:8px;padding:4px 6px}
  .stage-extras i{width:36px;height:30px}
  .stage-tag{font-size:11px;bottom:8px;inset-inline-start:8px}
}
html,body{overflow-anchor:none}
.menu-dialog{margin:0 0 0 auto}
.menu-dialog{inset:0 0 0 auto;margin:0}

/* =====================================================================
   Voice Customer Reviews (تجارب صوتية)
   ===================================================================== */
.reviews{background:var(--ivory);border-top:1px solid var(--line)}
.voice-reviews{max-width:1160px;margin:0 auto}
.voice-reviews+.section-heading{margin-top:52px}
.voice-header{text-align:center;max-width:620px;margin:0 auto 26px}
.voice-pill{display:inline-flex;align-items:center;gap:8px;background:var(--coffee);color:var(--white);padding:7px 22px;border-radius:999px;font-size:15px;box-shadow:0 6px 18px #7a523229;margin-bottom:16px}
.voice-pill svg{flex-shrink:0}
.voice-header h2{font-size:clamp(30px,3.5vw,46px);font-weight:700;color:var(--ink);margin-bottom:10px}
.voice-header p{font-size:17px;line-height:1.75;color:var(--muted);margin:0 auto}
.voice-track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:8px 4px 18px;-webkit-overflow-scrolling:touch}
.voice-track::-webkit-scrollbar{display:none}
.voice-card{flex:0 0 360px;max-width:90vw;scroll-snap-align:center;display:flex;align-items:center;gap:14px;background:var(--white);border:1.5px solid var(--line);border-radius:22px;padding:16px;box-shadow:0 8px 26px #3a2a1a0d;transition:border-color .2s,box-shadow .2s}
.voice-card:hover{border-color:#cbb89d}
.voice-card.is-playing{border-color:var(--coffee);box-shadow:0 10px 30px #7a52321f}
.voice-play{width:56px;height:56px;border-radius:50%;background:var(--coffee);color:var(--white);display:grid;place-items:center;flex-shrink:0;box-shadow:0 6px 16px #7a523236;transition:background .2s,transform .15s}
.voice-play:hover{background:var(--ink)}
.voice-play:active{transform:scale(.94)}
.voice-play .icon-play{transform:translateX(1.5px)}
.voice-play .icon-pause{display:none}
.voice-card.is-playing .voice-play .icon-play{display:none}
.voice-card.is-playing .voice-play .icon-pause{display:block}
.voice-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:12px}
.voice-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.voice-label{display:flex;align-items:center;gap:8px;min-width:0}
.voice-mic{width:30px;height:30px;border-radius:50%;background:var(--cream);color:var(--coffee);display:grid;place-items:center;flex-shrink:0}
.voice-title-wrap{display:flex;flex-direction:column;min-width:0;line-height:1.25}
.voice-title{font-size:15px;font-weight:700;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.voice-meta{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.voice-speeds{display:inline-flex;align-items:center;gap:2px;background:var(--cream);padding:3px;border-radius:999px;flex-shrink:0}
.voice-speeds button{font:700 12px/1 Arial,sans-serif;padding:5px 10px;border-radius:999px;color:var(--muted);transition:background .15s,color .15s}
.voice-speeds button[aria-pressed=true]{background:var(--coffee);color:var(--white)}
.voice-bottom{display:flex;align-items:center;gap:10px}
.voice-time{font:700 12px/1 Arial,sans-serif;color:var(--ink);background:var(--cream);padding:7px 10px;border-radius:999px;white-space:nowrap;flex-shrink:0}
.voice-wave{flex:1;height:28px;display:flex;align-items:center;justify-content:space-between;gap:2.5px;cursor:pointer;user-select:none}
.voice-bar{flex:1;min-width:2px;max-width:3.5px;height:var(--h,50%);min-height:4px;border-radius:999px;background:#dfd3c0;transition:background-color .12s}
.voice-bar.played{background:var(--coffee)}
.voice-dots{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:8px}
.voice-dot{width:9px;height:9px;border-radius:999px;background:#d8cbb6;padding:0;transition:width .25s ease,background-color .25s ease}
.voice-dot[aria-selected=true]{width:28px;background:var(--coffee)}
@media(max-width:640px){
  .voice-header{margin-bottom:20px}
  .voice-header p{font-size:15px}
  .voice-track{margin-inline:-6vw;padding-inline:6vw;gap:12px}
  .voice-card{flex:0 0 88%;max-width:350px;padding:14px 12px;gap:10px}
  .voice-play{width:50px;height:50px}
  .voice-speeds button{padding:5px 8px;font-size:11px}
  .voice-time{font-size:11px;padding:6px 8px}
}

/* =====================================================================
   Salla Checkout, Express Payment & Multi-Page Support
   ===================================================================== */
.installment-banner{margin:8px 0 14px;padding:10px 14px;background:var(--cream);border-inline-start:2px solid var(--coffee);border-radius:8px;font-size:14px;color:var(--muted)}
.installment-banner strong,.installment-banner b{color:var(--ink)}
.installment-hint{font-size:13px!important;color:var(--muted);border-top:1px dashed var(--line);padding-top:10px;margin-top:8px}
.teraz-bag-coupon{margin:12px 0;padding:12px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.teraz-bag-coupon .teraz-coupon-row{display:flex;gap:8px}
.teraz-bag-coupon input{flex:1;min-height:40px;padding:6px 12px;border:1px solid var(--line);border-radius:var(--radius);background:var(--white);color:var(--ink);font:14px inherit}
.teraz-bag-coupon button{min-height:40px;padding:6px 16px;font-size:14px}
.coupon-applied{display:block;margin-top:6px;color:var(--good);font-size:13px}
.discount-row strong{color:var(--good)}
.teraz-salla-payments{margin:12px 0}
.payments-label{display:block;font-size:13px;color:var(--muted);margin-bottom:8px}
.payment-pills{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.payment-pill{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:52px;padding:8px 6px;border:1px solid var(--line);border-radius:10px;background:var(--white);color:var(--ink);cursor:pointer;transition:border-color .2s,background .2s}
.payment-pill b{font-size:11px;letter-spacing:.03em;color:var(--coffee)}
.payment-pill span{font-size:13px}
.payment-pill[aria-pressed=true]{border-color:var(--ink);background:var(--ink);color:var(--white)}
.payment-pill[aria-pressed=true] b{color:var(--sand)}
.payment-desc{display:block;margin-top:8px;font-size:12px;color:var(--muted)}
.salla-step-bar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line);font-size:13px}
.salla-step-bar span{padding:4px 12px;border-radius:999px;background:var(--cream);color:var(--muted)}
.salla-step-bar span.done{color:var(--good);background:var(--good-bg)}
.salla-step-bar span.active{background:var(--ink);color:var(--white)}
.salla-checkout-section{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:16px}
.salla-checkout-section h3{font-size:19px;margin:0 0 14px}
.salla-address-grid,.salla-card-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.salla-card-grid label.full{grid-column:1/-1}
.salla-address-grid label,.salla-card-grid label{display:flex;flex-direction:column;gap:5px;font-size:14px;color:var(--muted)}
.salla-address-grid input,.salla-address-grid select,.salla-card-grid input{min-height:42px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--ivory);color:var(--ink);font:15px inherit}
.salla-pay-box{margin-top:14px;padding:14px;background:var(--cream);border:1px solid var(--line);border-radius:12px}
.salla-pay-box strong{display:block;margin-bottom:8px;font-size:16px;color:var(--ink)}
.bnpl-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.bnpl-steps>div{background:var(--white);border:1px solid var(--line);border-radius:8px;padding:10px 6px;text-align:center}
.bnpl-steps span{display:block;font-size:11px;color:var(--muted)}
.bnpl-steps b{font-size:14px;color:var(--ink)}
.confirmed-order-view{max-width:680px;margin:0 auto;text-align:center;grid-column:1/-1}
.order-receipt-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:20px 0 24px;text-align:right}
.order-receipt-grid>div{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.order-receipt-grid span{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}
.order-receipt-grid strong{font-size:16px;color:var(--ink)}
@media(max-width:640px){
  .payment-pills{grid-template-columns:repeat(2,1fr)}
  .salla-address-grid,.salla-card-grid,.bnpl-steps,.order-receipt-grid{grid-template-columns:1fr}
}

/* =====================================================================
   Salla Theme Editor Custom Image & Banner Components
   ===================================================================== */
#salla-home-components:empty{display:none}
.teraz-custom-banner,.teraz-custom-banners-grid,.teraz-custom-slider,.teraz-parallax-banner{max-width:1360px;margin:28px auto;padding:0 clamp(18px,4vw,48px)}
.teraz-custom-banner a{display:block;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:var(--cream)}
.teraz-custom-banner img{display:block;width:100%;height:auto;max-height:520px;object-fit:cover;transition:transform .4s ease}
.teraz-custom-banner a:hover img{transform:scale(1.015)}
.teraz-banners-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.teraz-banner-card{position:relative;display:block;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:var(--cream);aspect-ratio:4/3;text-decoration:none;color:var(--ink)}
.teraz-banner-card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}
.teraz-banner-card:hover img{transform:scale(1.03)}
.teraz-banner-caption{position:absolute;inset-inline:14px;bottom:14px;padding:12px 16px;border-radius:12px;background:rgba(251,247,239,.92);backdrop-filter:blur(6px)}
.teraz-banner-caption h3{margin:0;font-size:18px;color:var(--ink)}
.teraz-banner-caption p{margin:4px 0 0;font-size:14px;color:var(--muted)}
.teraz-slider-track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}
.teraz-slider-slide{flex:0 0 100%;scroll-snap-align:center;position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:var(--cream)}
.teraz-slider-slide img{width:100%;height:auto;max-height:540px;object-fit:cover;display:block}
.teraz-parallax-inner{position:relative;border-radius:18px;overflow:hidden;min-height:340px;display:flex;align-items:center;justify-content:center;text-align:center;padding:36px 24px;background-size:cover;background-position:center;border:1px solid var(--line)}
.teraz-parallax-inner::before{content:"";position:absolute;inset:0;background:rgba(25,21,17,.45)}
.teraz-parallax-content{position:relative;z-index:1;color:var(--ivory);max-width:640px}
.teraz-parallax-content h2{color:var(--ivory);margin:0 0 14px;font-size:clamp(24px,3.5vw,38px)}

/* =====================================================================
   Salla Documentation Compliance: Header Login, Native PDP, Cart,
   Thank-You Page & Customer Account Pages
   ===================================================================== */
.header-actions{display:flex;align-items:center;gap:10px}
.header-login-btn{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);padding:8px 14px;border-radius:999px;background:var(--white);color:var(--ink);font-size:14px;transition:border-color .2s,background .2s}
.header-login-btn:hover{border-color:var(--ink);background:var(--cream)}
.header-user-menu{display:inline-flex;align-items:center}
@media(max-width:640px){
  .header-login-btn span{display:none}
  .header-login-btn{padding:8px 10px}
}

.teraz-subpage{max-width:1280px;margin:0 auto;padding:36px clamp(18px,4vw,48px) 80px}
.teraz-subpage-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:28px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.teraz-subpage-title{font-size:clamp(28px,3.2vw,42px);margin:8px 0 0;color:var(--ink)}
.teraz-panel{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:clamp(18px,3vw,32px);margin-bottom:22px;box-shadow:var(--shadow)}

/* Customer Layout & Profile */
.teraz-customer-grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:28px;align-items:start}
.teraz-customer-sidebar{position:sticky;top:90px}
.teraz-customer-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow)}
.teraz-customer-main .form-input,
.teraz-customer-main input[type="text"],
.teraz-customer-main input[type="email"],
.teraz-customer-main input[type="tel"]{width:100%;min-height:44px;padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--ivory);color:var(--ink);font:15px inherit}
@media(max-width:860px){
  .teraz-customer-grid{grid-template-columns:1fr}
  .teraz-customer-sidebar{position:static}
}

/* Thank You Page */
.teraz-thankyou-page{max-width:1080px;margin:0 auto}
.teraz-thankyou-actions{display:flex;justify-content:center;gap:14px;margin-top:28px;flex-wrap:wrap}

/* Native Salla Cart Section (when Salla backend cart has items or on /cart) */
.teraz-salla-cart-section{max-width:1280px;margin:0 auto;padding:32px clamp(18px,4vw,48px) 60px;border-bottom:1px solid var(--line)}
.teraz-salla-cart-grid{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:28px;align-items:start;margin-top:22px}
.teraz-salla-cart-item{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:16px;position:relative}
.teraz-salla-cart-item-row{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:18px;align-items:center}
.teraz-salla-cart-item-img{width:110px;height:96px;border-radius:10px;background:var(--cream);overflow:hidden;display:block}
.teraz-salla-cart-item-img img{width:100%;height:100%;object-fit:contain}
.teraz-salla-cart-summary-box{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;position:sticky;top:90px;box-shadow:var(--shadow)}
.teraz-free-ship-box{background:var(--cream);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:18px}
.teraz-free-ship-progress-bg{height:8px;border-radius:999px;background:#dfd4c2;overflow:hidden;margin-top:10px}
.teraz-free-ship-progress-bar{height:100%;background:var(--good);border-radius:999px;transition:width .3s ease}
@media(max-width:900px){
  .teraz-salla-cart-grid{grid-template-columns:1fr}
  .teraz-salla-cart-summary-box{position:static}
  .teraz-salla-cart-item-row{grid-template-columns:84px minmax(0,1fr)}
}

/* Native Salla PDP & Category Extras */
.teraz-salla-pdp-extras,.teraz-salla-category-extras{max-width:1280px;margin:0 auto;padding:36px clamp(18px,4vw,48px) 64px;border-top:1px solid var(--line)}
.teraz-salla-pdp-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;margin-bottom:24px}
.teraz-salla-pdp-card h3{margin:0 0 14px;font-size:22px;color:var(--ink)}
.teraz-salla-form-row{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:16px}
.salla-native-payments{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:8px}

