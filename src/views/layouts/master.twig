      "ranks": {
        "thobe": 7,
        "casual": 1,
        "walking": 2
      }
    },
    {
      "id": "badr",
      "image": "black-white.webp",
      "order": 1,
      "group": "knit",
      "name": "ظل البدر",
      "color": "أسود مع قاعدة بيضاء",
