    logo: theme.settings.get('teraz_logo')|default(''),
    heroBg: theme.settings.get('teraz_hero_bg')|default(''),
    categories: {
      mule: theme.settings.get('teraz_img_cat_mule')|default(''),
      clogs: theme.settings.get('teraz_img_cat_clogs')|default(''),
      caps: theme.settings.get('teraz_img_cat_caps')|default(''),
      socks: theme.settings.get('teraz_img_cat_socks')|default(''),
      care: theme.settings.get('teraz_img_cat_care')|default('')
    },
    offers: {
      single: theme.settings.get('teraz_img_offer_single')|default(''),
      starter: theme.settings.get('teraz_img_offer_starter')|default(''),
      pair2: theme.settings.get('teraz_img_offer_pair2')|default('')
    },
    products: {
      'tuwaiq': theme.settings.get('teraz_img_tuwaiq')|default(''),
      'badr': theme.settings.get('teraz_img_badr')|default(''),
      'night': theme.settings.get('teraz_img_night')|default(''),
      'oud': theme.settings.get('teraz_img_oud')|default(''),
      'ramth': theme.settings.get('teraz_img_ramth')|default(''),
      'evening': theme.settings.get('teraz_img_evening')|default(''),
      'dahna': theme.settings.get('teraz_img_dahna')|default(''),
      'coffee': theme.settings.get('teraz_img_coffee')|default(''),
      'mule-0': theme.settings.get('teraz_img_mule_0')|default(''),
      'mule-1': theme.settings.get('teraz_img_mule_1')|default(''),
      'mule-2': theme.settings.get('teraz_img_mule_2')|default(''),
      'care-pack': theme.settings.get('teraz_img_care_pack')|default('')
