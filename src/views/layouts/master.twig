$$('[data-mega]').forEach(b => b.addEventListener('mouseenter', () => { if (matchMedia('(hover:hover)').matches) openMega(b.dataset.mega); }));
$('.site-header')?.addEventListener('mouseleave', () => { megaTimer = setTimeout(closeMega, 180); });
