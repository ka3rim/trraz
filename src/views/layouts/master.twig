/* ---------- offers & starter pack stock synchronization ---------- */
let starterPackGlobalInStock = true;
function isProductInStock(p) {
  if (!p) return false;
  if (p.inStock === false) return false;
  if (Array.isArray(p.parts) && p.parts.some(pid => {
    const sub = byId(pid);
    return sub && sub.inStock === false;
  })) return false;
  return true;
}
function isStarterPackAvailable(shoe) {
  if (!starterPackGlobalInStock) return false;
  for (const cid of ['cleaning-kit', 'water-shield', 'care-pack']) {
    const cp = byId(cid);
    if (cp && !isProductInStock(cp)) return false;
  }
  const socksList = catalog.filter(x => x.group === 'socks');
  if (socksList.some(s => !isProductInStock(s))) return false;
  if (shoe && shoe.group === 'knit') {
    if (!isProductInStock(shoe)) return false;
    const pairedSock = shoe.pair && shoe.pair[1] ? byId(shoe.pair[1]) : null;
    if (pairedSock && !isProductInStock(pairedSock)) return false;
  } else if (knit.every(k => !isProductInStock(k))) {
    return false;
  }
  return true;
}
function offersFor(p) {
  const sock = byId(p.pair[1]);
  const starterList = p.price + sock.price + byId('cleaning-kit').price + byId('water-shield').price;
  const list = [
    { key: 'single', title: 'لون واحد', sub: 'الجزمة بس.', price: p.price, list: p.price }
  ];
  if (isStarterPackAvailable(p)) {
    list.push({ key: 'starter', title: S.bundles.starter.name, sub: 'الجزمة، وشراب بلونها، وعدة التنظيف، وبخاخ العزل. كل اللي تحتاجه من أول يوم.', price: S.bundles.starter.price, list: starterList });
  }
  list.push({ key: 'pair2', title: S.bundles.pair2.name, sub: 'جزمتين بلونين: وحدة للدوام ووحدة للطلعات، أو لك ولأخوك.', price: S.bundles.pair2.price, list: p.price * 2 });
  return list;
}
const shipNote = price => price >= S.freeShippingThreshold ? '<span class="free-ship">التوصيل مجاني</span>' : `<span class="ship-fee">+ ${S.shippingFee} ريال توصيل</span>`;
function renderHomeOffers() {
  if (!$('#home-offers')) return;
  const p = byId('night');
  const meta = {
    single:  { img: siteImages.offers.single,  href: '#lp/all/single',  cta: 'اختر لونك' },
    starter: { img: siteImages.offers.starter, href: '#lp/all/starter', cta: 'اختر لونك ومقاسك' },
    pair2:   { img: siteImages.offers.pair2,   href: '#lp/all/pair2',   cta: 'اختر اللونين' }
  };
  $('#home-offers').innerHTML = offersFor(p).map(o => {
