{% extends "layouts.master" %}
{% set home_url = store.url|default('/') %}
{% block content %}
<div class="teraz teraz-subpage">
  <div class="product-breadcrumb">
    <a href="{{ home_url }}">→ العودة إلى الرئيسية</a>
    <span>طراز / {{ page.title }}</span>
  </div>
  <section class="section">
    <header class="section-heading">
      <div>
        <span class="eyebrow">آراء عملاء طراز</span>
        <h1>{{ page.title }}</h1>
      </div>
      <div class="teraz-sort-select">
        <label for="testimonials-filter">{{ trans('pages.categories.sorting') }}</label>
        <select id="testimonials-filter" class="form-input">
          <option value="latest">{{ trans('pages.testimonials.sort_by_date_desc') }}</option>
          <option value="oldest">{{ trans('pages.testimonials.sort_by_date_asc') }}</option>
          <option value="top_rating">{{ trans('pages.testimonials.sort_by_rating_desc') }}</option>
          <option value="bottom_rating">{{ trans('pages.testimonials.sort_by_rating_asc') }}</option>
        </select>
      </div>
    </header>
    <div class="teraz-panel">
      <salla-comments data-testid="store-testimonials-comments" testimonials></salla-comments>
    </div>
  </section>
</div>
{% endblock %}
{% block scripts %}
<script defer src="{{ 'testimonials.js' | asset }}"></script>
{% endblock %}
