{% set component = {} %}
{# Golden guarantee (#guarantee): 14-day return / 20-day exchange. #}
{% set c = component|default({}) %}
<section class="section guarantee" id="guarantee">
  <div>
    <span class="eyebrow">{{ c.eyebrow|default('الضمان الذهبي') }}</span>
    <h2>{{ c.title|default('اختَر وأنت
عارف حقك.')|nl2br }}</h2>
    <p>{{ c.text|default('جرّب الحذاء داخل المنزل أو في مكان نظيف، وحافظ على حالته وتغليفه. تأكد من المقاس والراحة قبل الاستخدام الخارجي.') }}</p>
  </div>
  <div class="guarantee-facts">
    <article>
      <strong>{{ c.return_days|default(14) }} <small>يومًا</small></strong>
      <h3>{{ c.return_title|default('لطلب الاسترجاع') }}</h3>
      <p>{{ c.return_text|default('من الاستلام، مع بقاء المنتج بحالته الأصلية.') }}</p>
    </article>
    <article>
      <strong>{{ c.exchange_days|default(20) }} <small>يومًا</small></strong>
      <h3>{{ c.exchange_title|default('لطلب الاستبدال') }}</h3>
      <p>{{ c.exchange_text|default('للمقاس أو اللون، حسب توفر المطلوب.') }}</p>
    </article>
    <p class="fine-print">{{ c.fine_print|default('*تكاليف شحن تغيير الرأي أو المقاس على العميل. طراز يتحملها عند الخطأ أو العيب المصنعي بعد التحقق. تطبق شروط الاسترجاع والاستبدال الخاصة بكل منتج.') }}</p>
  </div>
</section>


{# === teraz-questions === #}
{% set component = {} %}
{# FAQ accordions (#questions). Native <details>; the first one is open. Merchant "faqs" collection overrides the defaults. #}
{% set c = component|default({}) %}
{% set threshold = theme.settings.get('teraz_free_shipping_threshold')|default(479) %}
{% set defaults = [
  { question: 'ليش أختار طراز؟', answer: 'لأن يومك ما يوقف عند مناسبة واحدة. جزمة تليق بالثوب، ألوان تضبط الكاجوال، وكاب وشراب وخفّ يكمّلون اختياراتك. طراز يجمع لك تفاصيل كشخة الرجل السعودي من أول مشوار لآخر لقاء.' },
  { question: 'كيف أختار المقاس؟', answer: 'راجع إرشادات المقاس في صفحة جزمتك. الكابات والشرابات بمقاس واحد محدد تلقائيًا. جرّب الأحذية داخل المنزل، وحافظ على حالتها وتغليفها حتى تتأكد من المقاس.' },
  { question: 'أقدر أضيف الكاب والشراب مع الجزمة؟', answer: 'إيه، افتح المنتج وشوف «كمّل كشختك». اختر القطع اللي تعجبك وأضفها مع الجزمة، أو أضف كل قطعة لحالها. تقدر تعدل الكميات في الحقيبة.' },
  { question: 'كيف يعمل الشحن المجاني هنا؟', answer: 'الشحن مجاني عند وصول مجموع منتجاتك إلى ' ~ threshold ~ ' ر.س. يظهر المتبقي بعد الإضافة وفي مراجعة الحقيبة قبل الإتمام. تظهر لك تكلفة الشحن مع إجمالي حقيبتك قبل الإكمال.' },
  { question: 'وش يميّز شرابات الأناقة؟', answer: 'خفة تكمل لبسك الرسمي واليومي، وألوان تنسجم مع جزمك. 3 أزواج في كل باك، بمقاس واحد؛ تفصيلة صغيرة تكمل كشختك.' },
  { question: 'إذا ما كان مقاسي متوفرًا؟', answer: 'اضغط «نبّهني عند التوفر» داخل صفحة المنتج، وسنرسل لك إشعارًا عند توفر المقاس أو المنتج.' }
] %}
<section class="section questions" id="questions">
  <div>
    <span class="eyebrow">{{ c.eyebrow|default('قبل تختار') }}</span>
    <h2>{{ c.title|default('كل سؤال،
له جواب.')|nl2br }}</h2>
  </div>
  <div>
    {% for faq in c.faqs|default(defaults) %}
      <details{{ loop.first ? ' open' : '' }}>
        <summary>{{ faq.question }}</summary>
        <p>{{ faq.answer }}</p>
      </details>
    {% endfor %}
  </div>
</section>


{# === teraz-journal === #}
{% set component = {} %}
{# Journal grid (.journal) — 3 expandable guides. Merchant "articles" collection overrides the defaults. #}
{% set c = component|default({}) %}
{% set defaults = [
  { tag: '01 / تنسيق', title: 'كيف تختار جزمتك مع الثوب؟', text: 'ابدأ بالألوان الموجودة في لبسك. مع الثوب الأبيض، تعطي القاعدة البيضاء تباينًا أخف، والقاعدة الداكنة حضورًا أهدأ. إذا كانت بقية تفاصيلك بنية، قرّب درجة الجزمة منها. لا تحتاج تكرار اللون في كل شيء؛ يكفي رابط واحد بين الجزمة والكاب أو الشراب.' },
  { tag: '02 / اختيار', title: 'قبل تطلب جزمة أونلاين', text: 'راجع صور الموديل ومكوناته وإرشادات مقاسه تحديدًا. المقاس المعتاد قد يختلف بين القصّات. بعد الاستلام، جربه داخل البيت مع الشراب الذي تنوي لبسه، وحافظ على التغليف حتى تتأكد من اختيارك.' },
  { tag: '03 / عناية', title: 'كيف تعتني بالنسيج والجلد؟', text: 'أزل الغبار بفرشاة ناعمة واتبع تعليمات العناية الخاصة بالموديل. اختبر المنظف على جزء مخفي، وتجنب الغمر بالماء والحرارة المباشرة. لا تستخدم معالج الجلد على النسيج المحاك دون توصية مناسبة.' }
] %}
<section class="section journal">
  <span class="eyebrow">{{ c.eyebrow|default('دليل طراز') }}</span>
  <h2>{{ c.title|default('تفاصيل تعرفها.
واختيار تطمئن له.')|nl2br }}</h2>
  <div class="journal-grid">
    {% for article in c.articles|default(defaults) %}
      <details>
        <summary><small>{{ article.tag }}</small>{{ article.title }}</summary>
        <p>{{ article.text }}</p>
      </details>
    {% endfor %}
  </div>
</section>


{# === teraz-closing === #}
{% set component = {} %}
{# Closing call to action (.closing). #}
{% set c = component|default({}) %}
<section class="closing">
  <span class="eyebrow">{{ c.eyebrow|default('ملبوس العافية') }}</span>
  <h2>{{ c.title|default('يومك يتغيّر.
طرازك يرافقك.')|nl2br }}</h2>
  <a class="primary" href="{{ c.button_link|default('#knit') }}">{{ c.button_label|default('اختر بداية إطلالتك ←') }}</a>
</section>

    </div>
  </div>
{% endblock %}
