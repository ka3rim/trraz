{#
  TERAZ home page (src/views/pages/index.twig).
  Renders the full 18-section TERAZ storefront in exact prototype order.
#}
{% extends "layouts.master" %}

{% block title %}طراز — راحة تليق بالمقام{% endblock %}
{% block body_class %}teraz-home{% endblock %}

{% block content %}
  <div class="teraz">
    <div id="home-view">
      {% include 'components.home.teraz-hero' %}
      {% include 'components.home.teraz-collection-nav' %}
      {% include 'components.home.teraz-promise' %}
      {% include 'components.home.teraz-introduction' %}
      {% include 'components.home.teraz-occasion' %}
      {% include 'components.home.teraz-strip-knit' %}
      {% include 'components.home.teraz-material-story' %}
      {% include 'components.home.teraz-strip-caps' %}
      {% include 'components.home.teraz-editorial-caps' %}
      {% include 'components.home.teraz-strip-socks' %}
      {% include 'components.home.teraz-quiet-band' %}
      {% include 'components.home.teraz-strip-clogs' %}
      {% include 'components.home.teraz-editorial-clogs' %}
      {% include 'components.home.teraz-strip-care' %}
      {% include 'components.home.teraz-guarantee' %}
      {% include 'components.home.teraz-questions' %}
      {% include 'components.home.teraz-journal' %}
      {% include 'components.home.teraz-closing' %}
    </div>
  </div>
{% endblock %}
