{#
  TERAZ home page (src/views/pages/index.twig).
  Self-contained 18-section TERAZ storefront.
#}
{% extends "layouts.master" %}

{% block title %}طراز — راحة تليق بالمقام{% endblock %}
{% block body_class %}teraz-home{% endblock %}

{% block content %}
  <div class="teraz">
    <div id="home-view">
{# === teraz-hero === #}
{% set component = {} %}
{# Hero Atelier Stage — .hero / .atelier-stage with the 8 hero shoes on the stone stage (--column / --tier). #}
{% set c = component|default({}) %}
{% set stage = c.stage_image|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/atelier.webp') %}
<section class="hero" id="home">
  <div class="hero-wording">
    <p class="eyebrow">{{ c.eyebrow|default('للرجل السعودي. ولكل يوم في حياته.') }}</p>
    <h1>{{ c.title|default('راحة تليق بالمقام.') }}</h1>
    <p>{{ c.text_line_1|default('أحذية محاكة بتفاصيل جلدية تكمل ثوبك وكاجوالك.') }}<br class="mobile-only"> {{ c.text_line_2|default('ومعها كل ما يكمّل كشختك، في مكان واحد.') }}</p>
    <a class="primary" href="{{ c.button_link|default('#knit') }}">{{ c.button_label|default('اختر طرازك') }} <span>←</span></a>
  </div>
  <div class="atelier-stage" aria-label="مجموعة طراز الكاملة على منصات حجرية">
    <img class="stage-bg" src="{{ stage }}" width="1536" height="1024" alt="">
    {#
      Exhibits come from the "hero_products" field (max 8, in the order picked).
      If it is empty the controller fills #hero-shoes with the 8 TERAZ knit shoes found in the store.
    #}
    <div id="hero-shoes">
      {% for product in c.hero_products|default([])|slice(0, 8) %}
        <a href="{{ product.url }}" class="exhibit"
          style="--column:{{ loop.index0 % 4 }};--tier:{{ (loop.index0 / 4)|round(0, 'floor') }}"
          data-product-id="{{ product.id }}" data-sku="{{ product.sku }}" data-name="{{ product.name }}" data-url="{{ product.url }}"
          data-price="{{ product.price }}" data-image="{{ product.image.url }}" data-available="{{ product.is_available ? 'true' : 'false' }}"
          data-peek-img="{{ product.image.url }}" data-peek-name="{{ product.name }}"
          aria-label="اكتشف {{ product.name }}">
          <img src="{{ product.image.url }}" width="1200" height="900" alt="{{ product.name }}"><span>{{ product.name }} ↗</span>
        </a>
      {% else %}
      <a href="#p/tuwaiq" class="exhibit" data-fallback="true"
        style="--column:0;--tier:0"
        data-name="ثرى طويق" data-url="#p/tuwaiq"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige-white.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige-white.webp" data-peek-name="ثرى طويق" data-teraz-id="tuwaiq"
        aria-label="اكتشف ثرى طويق">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige-white.webp" width="1200" height="900" alt="ثرى طويق، بيج دافئ، بني، وأبيض"><span>ثرى طويق ↗</span>
      </a>
      <a href="#p/badr" class="exhibit" data-fallback="true"
        style="--column:1;--tier:0"
        data-name="ظل البدر" data-url="#p/badr"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black-white.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black-white.webp" data-peek-name="ظل البدر" data-teraz-id="badr"
        aria-label="اكتشف ظل البدر">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black-white.webp" width="1200" height="900" alt="ظل البدر، أسود مع قاعدة بيضاء"><span>ظل البدر ↗</span>
      </a>
      <a href="#p/night" class="exhibit" data-fallback="true"
        style="--column:2;--tier:0"
        data-name="عتيم الليل" data-url="#p/night"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black.webp" data-peek-name="عتيم الليل" data-teraz-id="night"
        aria-label="اكتشف عتيم الليل">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black.webp" width="1200" height="900" alt="عتيم الليل، أسود بالكامل"><span>عتيم الليل ↗</span>
      </a>
      <a href="#p/oud" class="exhibit" data-fallback="true"
        style="--column:3;--tier:0"
        data-name="عتيق العود" data-url="#p/oud"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown-white.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown-white.webp" data-peek-name="عتيق العود" data-teraz-id="oud"
        aria-label="اكتشف عتيق العود">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown-white.webp" width="1200" height="900" alt="عتيق العود، بني غني مع قاعدة بيضاء"><span>عتيق العود ↗</span>
      </a>
      <a href="#p/ramth" class="exhibit" data-fallback="true"
        style="--column:0;--tier:1"
        data-name="غصن الرمث" data-url="#p/ramth"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/olive.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/olive.webp" data-peek-name="غصن الرمث" data-teraz-id="ramth"
        aria-label="اكتشف غصن الرمث">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/olive.webp" width="1200" height="900" alt="غصن الرمث، زيتي، بني، وأبيض"><span>غصن الرمث ↗</span>
      </a>
      <a href="#p/evening" class="exhibit" data-fallback="true"
        style="--column:1;--tier:1"
        data-name="سكون المساء" data-url="#p/evening"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/gray.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/gray.webp" data-peek-name="سكون المساء" data-teraz-id="evening"
        aria-label="اكتشف سكون المساء">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/gray.webp" width="1200" height="900" alt="سكون المساء، رمادي مع قاعدة سوداء"><span>سكون المساء ↗</span>
      </a>
      <a href="#p/dahna" class="exhibit" data-fallback="true"
        style="--column:2;--tier:1"
        data-name="أرض الدهناء" data-url="#p/dahna"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige.webp" data-peek-name="أرض الدهناء" data-teraz-id="dahna"
        aria-label="اكتشف أرض الدهناء">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige.webp" width="1200" height="900" alt="أرض الدهناء، بيج مع قاعدة بنية"><span>أرض الدهناء ↗</span>
      </a>
      <a href="#p/coffee" class="exhibit" data-fallback="true"
        style="--column:3;--tier:1"
        data-name="حمسة البنّ" data-url="#p/coffee"
        data-price="319" data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown.webp" data-available="true"
        data-peek-img="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown.webp" data-peek-name="حمسة البنّ" data-teraz-id="coffee"
        aria-label="اكتشف حمسة البنّ">
        <img src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown.webp" width="1200" height="900" alt="حمسة البنّ، بني بالكامل"><span>حمسة البنّ ↗</span>
      </a>
      {% endfor %}
    </div>
    <div id="hero-peek" aria-hidden="true"><img alt=""><span></span></div>
  </div>
  <div class="hero-bottom">
    <span>{{ c.bottom_start|default('قماش محاك · تفاصيل جلدية · ألوان تشبهك') }}</span>
    <span>{{ c.bottom_end|default('مرّر لتكتشف. اضغط لتختار.') }}</span>
  </div>
</section>


{# === teraz-collection-nav === #}
{% set component = {} %}
{# Collection navigation (.collection-nav). Links are editable; defaults are the 5 prototype collections. #}
{% set c = component|default({}) %}
{% set defaults = [
  { label: 'الأحذية المحاكة', hint: 'للثوب والكاجوال', link: '#knit' },
  { label: 'الكابات', hint: 'كمّل إطلالتك', link: '#caps' },
  { label: 'الشرابات', hint: 'تفاصيل تفرق', link: '#socks' },
  { label: 'خفّ الكشخة', hint: 'للمشوار الخفيف', link: '#clogs' },
  { label: 'العناية بالجزم', hint: 'نظافة وحماية', link: '#care' }
] %}
<nav class="collection-nav" aria-label="اختر مجموعتك">
  {% for item in c.links|default(defaults) %}
    <a href="{{ item.link }}">{{ item.label }} <span>{{ item.hint }}</span></a>
  {% endfor %}
</nav>


{# === teraz-promise === #}
{% set component = {} %}
{# Promise bar (.promise). #}
{% set c = component|default({}) %}
<section class="promise">
  <span>{{ c.item_1|default('طراز يبدأ من راحتك.') }}</span>
  <span>{{ c.item_2|default('للثوب والكاجوال') }}</span>
  <span>{{ c.item_3|default('استرجاع خلال 14 يومًا*') }}</span>
  <a href="{{ c.link_url|default('#guarantee') }}">{{ c.link_label|default('تعرّف على الضمان الذهبي ↙') }}</a>
</section>


{# === teraz-introduction === #}
{% set component = {} %}
{# Introduction — "ليش طراز؟" (#why). Titles use real line breaks; nl2br turns them into <br>. #}
{% set c = component|default({}) %}
<section class="section introduction" id="why">
  <div>
    <span class="eyebrow">{{ c.eyebrow|default('ليش طراز؟') }}</span>
    <h2>{{ c.title|default('لأنك تعرف قيمة
التفاصيل.')|nl2br }}</h2>
  </div>
  <div>
    <p class="lead">{{ c.lead|default('من دوامك إلى مجلسك، كشختك تسبق كلامك. طراز يجمع النسيج المحاك والتفاصيل الجلدية والألوان المتناسقة؛ عشان تختار جزمة تليق بثوبك، وتكمل بها يومك بالكاجوال.') }}</p>
    <div class="reason-row">
      <article>
        <small>01</small>
        <h3>{{ c.reason_1_title|default('الخامة لها حضور.') }}</h3>
        <p>{{ c.reason_1_text|default('اختلاف الملمس بين القماش والجلد يعطي التصميم عمقًا، بعيدًا عن زحمة التفاصيل.') }}</p>
      </article>
      <article>
        <small>02</small>
        <h3>{{ c.reason_2_title|default('تلبسها على طرازك.') }}</h3>
        <p>{{ c.reason_2_text|default('مع الثوب أو الكاجوال؛ اختَر ترتيب الاستخدام الأقرب ليومك، ثم اللون اللي يشبهك.') }}</p>
      </article>
    </div>
  </div>
</section>


{# === teraz-occasion === #}
{% set component = {} %}
{# Occasion section (.occasion-section): two editorial cards. Images default to the theme assets. #}
{% set c = component|default({}) %}
<section class="occasion-section">
  <div>
    <span class="eyebrow">{{ c.eyebrow|default('يومك له أكثر من طراز') }}</span>
    <h2>{{ c.title|default('للدوام كشخة.
وللمشوار كشخة.')|nl2br }}</h2>
    <p>{{ c.text|default('ابدأ بالقطعة الأقرب ليومك، وكمّلها بألوان تنسجم معها.') }}</p>
  </div>
  <a href="{{ c.card_1_link|default('#knit') }}" class="occasion-card">
    <img src="{{ c.card_1_image|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black.webp') }}" alt="{{ c.card_1_alt|default('عتيم الليل بكامل اللون الأسود') }}" loading="lazy" width="1200" height="900">
    <span>{{ c.card_1_title|default('للثوب والدوام') }} <b>{{ c.card_1_cta|default('اكتشف مجموعة الأناقة ←') }}</b></span>
  </a>
  <a href="{{ c.card_2_link|default('#clogs') }}" class="occasion-card">
    <img src="{{ c.card_2_image|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/clogs-1.webp') }}" alt="{{ c.card_2_alt|default('خف الكشخة الجملي للمشاوير اليومية') }}" loading="lazy" width="1200" height="900">
    <span>{{ c.card_2_title|default('للمشوار القريب') }} <b>{{ c.card_2_cta|default('اكتشف خفّ الكشخة ←') }}</b></span>
  </a>
</section>


{# === teraz-strip-knit === #}
{% set component = {} %}
{% set group = 'knit' %}
{#
  Product strip (.product-strip) — shared by the 5 TERAZ collections. Expects `group`: knit | caps | socks | clogs | care.

  Products: the "products" field (hand-picked, in that order) renders server-side as cards.
  If empty and a "category" is chosen, the controller loads that category with salla.product.fetch()
  and renders the same cards client-side.

  knit  -> prev/next scroll controls + the 3-mode sort bar (data-sort="thobe" | "casual" | "walking").
  care  -> .care-collection layout + the 2 care steps underneath.
#}
{% set c = component|default({}) %}
{% set threshold = theme.settings.get('teraz_free_shipping_threshold')|default(479) %}
{% set all_copy = {
  knit: {
    eyebrow: '01 / TERAZ–KNIT',
    title: 'مجموعة الأناقة',
    text: 'كشخة الرجل السعودي تبدأ من التفاصيل. أحذية محاكة بتفاصيل جلدية وألوان تكمل الثوب والكاجوال؛ اختر طراز يومك.',
    label: 'منتجات مجموعة الأناقة'
  },
  caps: {
    eyebrow: '02 / تفصيلة ترافقك',
    title: 'كابات طراز',
    text: 'تطلع فيه، وتصفطه معك. ألوان تتناسق مع جزمتك وتكمل إطلالتك.',
    label: 'كابات طراز'
  },
  socks: {
    eyebrow: '03 / التفاصيل القريبة',
    title: 'شرابات الأناقة',
    text: 'خفيفة من ألياف البامبو، وألوان تكمل مجموعة الأناقة. 3 أزواج في كل باك، بمقاس واحد.',
    label: 'شرابات الأناقة'
  },
  clogs: {
    eyebrow: '04 / للمشوار الخفيف',
    title: 'خفّ الكشخة',
    text: 'لطلعة سريعة، أو لوقتك في البيت. تلبسه بسهولة وتبقى على طرازك.',
    label: 'خف الكشخة'
  },
  care: {
    eyebrow: '05 / الكشخة تستاهل العناية',
    title: 'مجموعة العناية بالجزم',
    text: 'نظّفها. احمِها. واطلع بكشختك.
مجموعة تنظيف متكاملة وبخاخ عزل ماء؛ كل منتج بـ29 ر.س.',
    label: 'منتجات العناية بالجزم'
  }
} %}
{% set copy = all_copy[group] %}
<section class="section collection{{ group == 'care' ? ' care-collection' : '' }}" id="{{ group }}">
  <header class="section-heading">
    <div>
      <span class="eyebrow">{{ c.eyebrow|default(copy.eyebrow) }}</span>
      <h2>{{ c.title|default(copy.title) }}</h2>
      <p>{{ c.text|default(copy.text)|nl2br }}</p>
    </div>
    {% if group == 'knit' %}
      <div class="strip-controls">
        <button type="button" data-scroll="knit" data-dir="1" aria-label="المنتجات السابقة">→</button>
        <button type="button" data-scroll="knit" data-dir="-1" aria-label="المنتجات التالية">←</button>
      </div>
    {% endif %}
  </header>

  {% if group == 'knit' %}
    <div class="sort-bar" role="group" aria-label="رتّب حسب">
      <span>رتّب حسب</span>
      <button type="button" data-sort="thobe" aria-pressed="true">الثوب</button>
      <button type="button" data-sort="casual" aria-pressed="false">الكاجوال</button>
      <button type="button" data-sort="walking" aria-pressed="false">المشي</button>
    </div>
  {% endif %}

  <div class="product-strip" data-group="{{ group }}" data-category="{{ c.category|default('')|json_encode|e('html_attr') }}" tabindex="0" aria-label="{{ copy.label }}">
    {% for product in c.products|default([]) %}
      {# Product card shared by every strip, the hero stage and server-rendered lists. Expects `product` (Salla product). #}
{% set card_image = product.image.url|default('') %}
<article class="product-card"
  data-product-id="{{ product.id }}"
  data-sku="{{ product.sku }}"
  data-name="{{ product.name }}"
  data-url="{{ product.url }}"
  data-price="{{ product.price }}"
  data-regular-price="{{ product.regular_price|default(product.price) }}"
  data-image="{{ card_image }}"
  data-available="{{ product.is_available ? 'true' : 'false' }}">
  <a class="product-image" href="{{ product.url }}" aria-label="تفاصيل {{ product.name }}">
    <img loading="lazy" src="{{ card_image }}" width="1200" height="900" alt="{{ product.image.alt|default(product.name) }}">
  </a>
  <div class="card-meta">
    {# Colour line: Salla subtitle as a fallback, replaced by the TERAZ colour once the product resolves. #}
    <span class="card-color">{{ product.subtitle|default('') }}</span>
    <h3><a href="{{ product.url }}">{{ product.name }}</a></h3>
    <div class="card-bottom">
      <b>{{ product.price|money }}</b>
      {% if product.is_on_sale %}<del class="card-regular">{{ product.regular_price|money }}</del>{% endif %}
      {% if not product.is_available %}<span class="card-flag">غير متوفر</span>{% endif %}
      <a href="{{ product.url }}">اكتشف التفاصيل ↗</a>
    </div>
  </div>
</article>

    {% else %}
    <article class="product-card" data-fallback="true"
      data-sku="night"
      data-name="عتيم الليل"
      data-url="#p/night"
      data-price="319"
      data-regular-price="319"
      data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black.webp"
      data-available="true"
      data-teraz-id="night">
      <a class="product-image" href="#p/night" aria-label="تفاصيل عتيم الليل">
        <img loading="lazy" src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/black.webp" width="1200" height="900" alt="عتيم الليل، أسود بالكامل">
      </a>
      <div class="card-meta">
        <span class="card-color">أسود بالكامل</span>
        <h3><a href="#p/night">عتيم الليل</a></h3>
        <div class="card-bottom">
          <b>319 ر.س</b>
          <a href="#p/night">اكتشف التفاصيل ↗</a>
        </div>
      </div>
    </article>
    <article class="product-card" data-fallback="true"
      data-sku="coffee"
      data-name="حمسة البنّ"
      data-url="#p/coffee"
      data-price="319"
      data-regular-price="319"
      data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown.webp"
      data-available="true"
      data-teraz-id="coffee">
      <a class="product-image" href="#p/coffee" aria-label="تفاصيل حمسة البنّ">
        <img loading="lazy" src="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/brown.webp" width="1200" height="900" alt="حمسة البنّ، بني بالكامل">
      </a>
      <div class="card-meta">
        <span class="card-color">بني بالكامل</span>
        <h3><a href="#p/coffee">حمسة البنّ</a></h3>
        <div class="card-bottom">
          <b>319 ر.س</b>
          <a href="#p/coffee">اكتشف التفاصيل ↗</a>
        </div>
      </div>
    </article>
    <article class="product-card" data-fallback="true"
      data-sku="dahna"
      data-name="أرض الدهناء"
      data-url="#p/dahna"
      data-price="319"
      data-regular-price="319"
      data-image="https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/beige.webp"
      data-available="true"
      data-teraz-id="dahna">
