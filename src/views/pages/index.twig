{#
  TERAZ home page.

  Merchant-driven: every section is a Salla home component declared in twilight.json (home.teraz-*),
  so sections can be reordered / edited in the dashboard.
  Fallback: when no component has been added yet, the prototype's exact section order is rendered
  with the built-in default copy, so a fresh install looks identical to the prototype.
#}
{% extends 'layouts.master' %}

{% block title %}طراز — راحة تليق بالمقام{% endblock %}
{% block body_class %}teraz-home{% endblock %}

{% block content %}
  <div class="teraz">
    <div id="home-view">
      {% if page.components|length %}
        {% for component in page.components %}
          {% component component.path %}
        {% endfor %}
      {% else %}
        {% set default_sections = [
          'teraz-hero', 'teraz-collection-nav', 'teraz-promise', 'teraz-introduction', 'teraz-occasion',
          'teraz-strip-knit', 'teraz-material-story',
          'teraz-strip-caps', 'teraz-editorial-caps',
          'teraz-strip-socks', 'teraz-quiet-band',
          'teraz-strip-clogs', 'teraz-editorial-clogs',
          'teraz-strip-care',
          'teraz-guarantee', 'teraz-questions', 'teraz-journal', 'teraz-closing'
        ] %}
        {% for section in default_sections %}
          {% include 'components.home.' ~ section %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
{% endblock %}
