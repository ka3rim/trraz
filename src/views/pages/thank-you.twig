{#
  TERAZ 2.0 Thank You Page (src/views/pages/thank-you.twig)
  Strictly follows Salla Twilight Documentation for Thank You / Order Confirmation Page
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('pages.thank_you.title')|default('شكرًا لطلبك') }} | {{ store.name|default('طراز') }}{% endblock %}
{% block body_class %}teraz-thank-you{% endblock %}

{% block content %}
  {% hook 'thank-you:start' %}
  <div class="teraz-subpage teraz-thankyou-page" data-testid="store-thank-you-page">
    <div class="teraz-panel">
      <salla-thank-you-page data-testid="store-thank-you-component">
        <div slot="header">
          <salla-thank-you-header
            title="{{ thank_you_title }}"
            subtitle="{{ trans('pages.thank_you.Order_placed_message') }}"
            button-label="{{ trans('pages.thank_you.order_details') }}"
            countdown-title="{{ trans('pages.thank_you.Purchase_return_available') }}"
            countdown-subtitle="{{ trans('pages.thank_you.cancel_modifiy_order') }}"
            order-id-label="{{ trans('pages.thank_you.order_id') }}"
            data-testid="store-thank-you-header">
          </salla-thank-you-header>
        </div>

        {% hook 'thank-you:items.start' %}
        <div slot="order-info">
          {% if order.Integration_fields.shipments|length %}
            <salla-order-shipments data-testid="store-order-shipments"></salla-order-shipments>
          {% else %}
            <salla-order-branch data-testid="store-order-branch"></salla-order-branch>
          {% endif %}
        </div>
        {% hook 'thank-you:items.end' %}

        <div slot="payment">
          <salla-order-payment
            payment-details-label="{{ trans('pages.thank_you.payment_details') }}"
            resend-invoice-label="{{ trans('pages.thank_you.resend_invoice') }}"
            invoice-sent-label="{{ trans('pages.thank_you.invoice_sent') }}"
            email-placeholder="{{ trans('common.elements.email') }}"
            send-label="{{ trans('common.elements.send') }}"
            data-testid="store-order-payment">
          </salla-order-payment>

          <salla-order-rewards
            title="{{ trans('pages.thank_you.You_earned') }}"
            subtitle="{{ trans('pages.thank_you.scored_for_conducting') }}"
            button-label="{{ trans('pages.thank_you.discover_rewards') }}"
            points-label="{{ trans('pages.loyalty_program.point') }}"
            data-testid="store-order-rewards">
          </salla-order-rewards>

          <salla-next-order-coupon
            title="{{ trans('pages.thank_you.coupon_gift') }}"
            coupon-label="{{ trans('pages.thank_you.next_order_coupon') }}"
            expires-label="{{ trans('pages.thank_you.expires_in') }}"
            copy-label="{{ trans('pages.thank_you.copy_coupon') }}"
            data-testid="store-next-order-coupon">
          </salla-next-order-coupon>
        </div>

        {% hook 'thank-you:payment.end' %}

        <div slot="contacts">
          <salla-contacts
            title="{{ trans('pages.thank_you.keep_in_touch') }}"
            data-testid="store-thank-you-contacts">
          </salla-contacts>
        </div>
      </salla-thank-you-page>

      <div class="teraz-thankyou-actions">
        <a href="{{ store.url|default('/') }}" class="primary">العودة للمتجر ومواصلة التسوق <span>←</span></a>
      </div>
    </div>
  </div>
  {% hook 'thank-you:end' %}
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'thank-you.js' | asset }}"></script>
  <script>
    try { localStorage.removeItem('teraz-cart-v4'); } catch (e) {}
  </script>
{% endblock %}
