{% extends "layouts.master" %}
{% set home_url = store.url|default('/') %}

{% block styles %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ 'fonts/hugeicons-font.css'|cdn }}"/>
{% endblock %}

{% block content %}
<div class="teraz teraz-subpage teraz-thankyou-page">
  <div class="product-breadcrumb">
    <a href="{{ home_url }}">→ العودة إلى الرئيسية</a>
    <span>طراز / تأكيد الطلب</span>
  </div>

  <section class="section">
    <header class="section-heading">
      <div>
        <span class="eyebrow">ملبوس العافية</span>
        <h1>{{ thank_you_title|default('شكرًا لاختيارك طراز.') }}</h1>
        <p>طلبك قيد التجهيز بعناية. يمكنك متابعة تفاصيل الشحنة والفاتورة أدناه.</p>
      </div>
    </header>

    {% hook 'thank-you:start' %}
    <div class="teraz-panel">
      <salla-thank-you-page class="thank-you-content">
        <div slot="main">
          <salla-thank-you-header heading="{{ thank_you_title }}"
            subtitle="{{ thank_you_components.subtitle ?? thank_you_subtitle ?? trans('pages.thank_you.order_received') }}"
            store-logo="{{ store.logo ? store.logo|cdn(48, 48) : '' }}" store-name="{{ store.name }}"
            reference-id="{{ order.reference_id }}" created-at="{{ order.created_at|date('c') }}">
            {% if order.instructions %}
              <article class="article article--main article--small text-center">{{ order.instructions|raw }}</article>
            {% endif %}
            {% for message in messages %}
              <span class="font-bold">{{ message }}</span>
            {% endfor %}
          </salla-thank-you-header>

          {% hook 'thank-you:items.start' %}
          {% set thank_you_items = order.items|map(item => {id: item.id, name: item.name, image: item.image, quantity: item.quantity, price: item.price, url: item.product ? item.product.url : null}) %}
          {% if order.is_pickable %}
            <salla-order-branch data-testid="store-thankyou-branch" items="{{ thank_you_items|json_encode }}" currency="{{ order.payment_currency }}" sticky-cta></salla-order-branch>
          {% else %}
            <salla-order-shipments data-testid="store-thankyou-shipments" items="{{ thank_you_items|json_encode }}" currency="{{ order.payment_currency }}" initial-shipments="{{ order.thank_you_shipments|json_encode }}" sticky-cta></salla-order-shipments>
          {% endif %}
          {% hook 'thank-you:items.end' %}

          <salla-order-payment data-testid="store-thankyou-payment"
            payment-method="{{ order.payment_method }}" currency="{{ order.payment_currency }}"
            payment-logo="{{ ('images/payment/' ~ order.payment_method ~ '_mini.png')|cdn(58, 58) }}"
            sub-total="{{ order.sub_total }}" total="{{ order.total }}"
            {% if order.tax %}tax-amount="{{ order.tax.amount }}"{% endif %}
            {% if order.shipping_cost %}shipping-cost="{{ order.shipping_cost }}"{% endif %}
            {% if order.cod_cost %}cod-cost="{{ order.cod_cost }}"{% endif %}
            {% if order.discounts is not empty %}discounts="{{ order.discounts|json_encode }}"{% endif %}
            invoice-url="{{ order.print_url }}"></salla-order-payment>
        </div>

        {% hook 'thank-you:payment.end' %}

        {% set show_loyalty = (thank_you_components.show_loyalty ?? true) and order.loyalty_points %}
        {% set cashback = (thank_you_components.show_cashback ?? true) ? order.thank_you_cashback : null %}
        {% if show_loyalty or cashback %}
          <salla-order-rewards data-testid="store-thankyou-rewards"
            {% if show_loyalty %}loyalty-points="{{ order.loyalty_points }}" loyalty-url="{{ link('loyalty') }}"{% endif %}
            {% if cashback %}cashback-amount="{{ cashback.amount }}" currency="{{ cashback.currency }}" cashback-url="{{ link('wallet') }}"{% endif %}
          ></salla-order-rewards>
        {% endif %}

        {% if thank_you_components.show_coupons ?? true %}
          <salla-next-order-coupon data-testid="store-thankyou-coupon"></salla-next-order-coupon>
        {% endif %}

        {% if thank_you_components.show_contacts ?? true %}
          <salla-contacts data-testid="store-thankyou-contacts"
            {% if thank_you_components.contact_channels is defined and thank_you_components.contact_channels is not null %}channels="{{ thank_you_components.contact_channels|join(',') }}"{% endif %}
            introduction="{{ trans('pages.thank_you.contact_us') }}" hide-title horizontal icons-only></salla-contacts>
        {% endif %}

        {% hook 'thank-you:end' %}
      </salla-thank-you-page>
    </div>
  </section>
</div>
{% endblock %}
