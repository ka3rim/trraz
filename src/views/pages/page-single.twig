{#
  TERAZ Static / Information Page (src/views/pages/page-single.twig).
#}
{% extends "layouts.master" %}

{% set home_url = store.url|default('/') %}

{% block title %}{{ page.title }} | {{ store.name|default('طراز') }}{% endblock %}

{% block content %}
<div class="teraz teraz-subpage">
  <div class="product-breadcrumb">
    <a href="{{ home_url }}">→ العودة إلى الرئيسية</a>
    <span>طراز / {{ page.title }}</span>
  </div>

  {% if page.type == 'customised' %}
    <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
  {% else %}
    <section class="section">
      <header class="section-heading">
        <div>
          <span class="eyebrow">طراز / معلومات وسياسات المتجر</span>
          <h1>{{ page.title }}</h1>
        </div>
      </header>
      <div class="teraz-panel teraz-prose-card">
        <div class="content-entry">
          {{ page.content|raw }}
        </div>
        <salla-comments data-testid="store-page-comments" item-id="{{ page.id }}" type="page"></salla-comments>
      </div>
    </section>
  {% endif %}
</div>
{% endblock %}
