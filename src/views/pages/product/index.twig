{#
  TERAZ Category & Products Listing Page (src/views/pages/product/index.twig).
  Preserves Salla's <salla-products-list>, <salla-filters>, and hooks while styling the entire page
  in the bespoke TERAZ Atelier aesthetic and providing a rich TERAZ catalog grid fallback.
#}
{% extends "layouts.master" %}

{% set home_url = store.url|default('/') %}

{% block title %}{{ page.title|striptags|default('مجموعة طراز') }} | {{ store.name|default('طراز') }}{% endblock %}
{% block body_class %}teraz-category{% endblock %}

{% block content %}
<div class="teraz teraz-category-page">
  <div class="product-breadcrumb">
    <a href="{{ home_url }}">→ العودة إلى الرئيسية</a>
    <span>طراز / {{ page.title|raw }}</span>
  </div>

  <nav class="collection-nav" aria-label="اختر مجموعتك">
    <a href="{{ home_url }}#knit">الأحذية المحاكة <span>للثوب والكاجوال</span></a>
    <a href="{{ home_url }}#caps">الكابات <span>كمّل إطلالتك</span></a>
    <a href="{{ home_url }}#socks">الشرابات <span>تفاصيل تفرق</span></a>
    <a href="{{ home_url }}#clogs">خفّ الكشخة <span>للمشوار الخفيف</span></a>
    <a href="{{ home_url }}#care">العناية بالجزم <span>نظافة وحماية</span></a>
  </nav>

  <div class="s-blocks-wrapper s-before-products-list">{% hook 'product.index.before_products_group_with_filter' %}</div>

  <section class="section collection">
    <header class="section-heading">
      <div>
        <span class="eyebrow">TERAZ COLLECTION / مجموعات طراز</span>
        <h1 id="page-main-title">{{ page.title|raw }}</h1>
        <p>كشخة الرجل السعودي تبدأ من التفاصيل. أحذية محاكة بتفاصيل جلدية وتنسيقات متكاملة ليومك.</p>
      </div>
      {% if sort_options|length %}
        <div class="teraz-sort-select">
          <label for="product-filter">{{ trans('pages.categories.sorting') }}</label>
          <select id="product-filter" class="form-input">
            {% for sort in sort_options %}
              <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
            {% endfor %}
          </select>
        </div>
      {% endif %}
    </header>

    <div class="sort-bar" role="group" aria-label="رتّب حسب">
      <span>رتّب حسب</span>
      <button type="button" data-sort="thobe" aria-pressed="true">الثوب</button>
      <button type="button" data-sort="casual" aria-pressed="false">الكاجوال</button>
      <button type="button" data-sort="walking" aria-pressed="false">المشي</button>
    </div>

    <div class="teraz-category-layout">
      {% if filters %}
        <aside class="teraz-filters-sidebar">
          <button class="btn--close-sm close-filters sicon-cancel hidden"></button>
          <salla-filters data-testid="store-products-filters" id="filters-menu"></salla-filters>
        </aside>
      {% endif %}

      <div class="teraz-category-main">
        {% hook 'product:index.items.start' %}

        {% set sort_list = sort_options|default([]) %}
        {% set first_sort = sort_list|first %}
        {% set has_selected_sort = sort_list|filter(sort => sort.is_selected)|length %}
        {% set fallback_sort = (sort_list|length and not has_selected_sort and first_sort.id != 'ourSuggest') ? first_sort.id : '' %}

        <div class="teraz-salla-list-wrap">
          <salla-products-list data-testid="store-products-list" class="flex-1 min-w-0" source="{{ page.slug }}" source-value="{{ page.id }}" sort-by="{{ fallback_sort }}" {{ filters ? 'filters-Results' : '' }}></salla-products-list>
        </div>

        {# Fallback / preview TERAZ grid when the demo store category has no live products yet #}
        <div class="product-strip teraz-grid-mode" id="category-teraz-grid" data-group="knit" tabindex="0" aria-label="منتجات مجموعة طراز"></div>

        {% hook 'product:index.items.end' %}
      </div>
    </div>
  </section>

  <div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

  <section class="section guarantee" id="guarantee">
    <div>
      <span class="eyebrow">الضمان الذهبي</span>
      <h2>اختَر وأنت<br>عارف حقك.</h2>
      <p>جرّب الحذاء داخل المنزل أو في مكان نظيف، وحافظ على حالته وتغليفه. تأكد من المقاس والراحة قبل الاستخدام الخارجي.</p>
    </div>
    <div class="guarantee-facts">
      <article>
        <strong>14 <small>يومًا</small></strong>
        <h3>لطلب الاسترجاع</h3>
        <p>من الاستلام، مع بقاء المنتج بحالته الأصلية.</p>
      </article>
      <article>
        <strong>20 <small>يومًا</small></strong>
        <h3>لطلب الاستبدال</h3>
        <p>للمقاس أو اللون، حسب توفر المطلوب.</p>
      </article>
      <p class="fine-print">*تكاليف شحن تغيير الرأي أو المقاس على العميل. طراز يتحملها عند الخطأ أو العيب المصنعي بعد التحقق.</p>
    </div>
  </section>

  <div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
</div>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
