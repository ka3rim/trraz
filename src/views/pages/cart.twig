{#
  TERAZ Cart & Review Page (src/views/pages/cart.twig).
  Matches the exact TERAZ Atelier bag & review aesthetic while supporting full Salla cart operations,
  coupons, conditional offers, and Complete-the-Look cross-sell recommendations.
#}
{% extends "layouts.master" %}

{% set home_url = store.url|default('/') %}
{% set threshold = theme.settings.get('teraz_free_shipping_threshold')|default(479) %}
{% set shipping_fee = theme.settings.get('teraz_shipping_fee')|default(29) %}
{% set sub_num = cart.sub_total|default(0) %}
{% set remaining = sub_num >= threshold ? 0 : (threshold - sub_num) %}
{% set progress = threshold > 0 ? ((sub_num / threshold) * 100) : 0 %}
{% if progress > 100 %}{% set progress = 100 %}{% endif %}

{% block title %}{{ page.title|default('حقيبتك') }} | {{ store.name|default('طراز') }}{% endblock %}
{% block body_class %}teraz-cart{% endblock %}

{% block content %}
<div class="teraz teraz-cart-page">
  <div class="product-breadcrumb">
    <a href="{{ home_url }}#knit">→ العودة إلى المجموعة</a>
    <span>طراز / حقيبتك</span>
  </div>

  <section class="section teraz-cart-section">
    <header class="section-heading">
      <div>
        <span class="eyebrow">على طرازك</span>
        <h1>حقيبتك ومراجعة طلبك</h1>
        <p>راجع المقاسات والكميات، أو أضف ما يكمل كشختك قبل إتمام الطلب.</p>
      </div>
    </header>

    <salla-conditional-offer data-testid="store-cart-conditional-offer"></salla-conditional-offer>

    <div id="cart-page-host" class="teraz-cart-grid">
      <div class="checkout-main">
        <div id="cart-page-shipping">
          <div class="shipping-progress">
            <div>
              <span>{{ remaining > 0 ? ('باقي ' ~ remaining ~ ' ر.س للشحن المجاني') : 'وصلت للشحن المجاني' }}</span>
              <small>شحن مجاني من {{ threshold }} ر.س</small>
            </div>
            <progress value="{{ progress }}" max="100" aria-label="التقدم نحو حد الشحن المجاني">{{ progress|round }}%</progress>
          </div>
        </div>

        {% hook 'cart:items.start' %}

        <div id="cart-page-lines" class="cart-lines">
          {% for item in cart.items|default([]) %}
            <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
              <article data-testid="store-cart-item-{{ item.id }}" class="cart-line" data-line="{{ item.id }}">
                <input type="hidden" name="id" value="{{ item.id }}">
                <a href="{{ item.url }}">
                  <img src="{{ item.product_image }}" width="1200" height="900" alt="{{ item.product_name }}" loading="{{ loop.first ? 'eager' : 'lazy' }}">
                </a>
                <div>
                  <h3><a href="{{ item.url }}">{{ item.product_name }}</a></h3>
                  <p>
                    <span data-testid="store-cart-item-price" class="item-price">{{ item.price|money }}</span>
                    {% if item.weight_label %} · {{ trans('pages.products.weight') }} {{ item.weight_label }}{% endif %}
                  </p>
                  {% include 'pages.partials.product.options' with { product: item } %}
                  <salla-cart-item-offers
                    quantity="{{ item.quantity }}"
                    item-id="{{ item.id }}"
                    product-price="{{ item.product_price }}"
                    offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers>
                  <strong class="item-total">{{ item.total|money }}</strong>
                  <div class="qty-control">
                    {% if item.type != 'donating' and not item.is_hidden_quantity %}
                      <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                        class="teraz-salla-qty"
                        aria-label="Quantity"
                        value="{{ item.quantity }}" name="quantity">
                      </salla-quantity-input>
                    {% endif %}
                    <salla-button type="button" shape="icon" size="small" color="danger" class="remove-item"
                      data-testid="store-cart-item-delete-{{ item.id }}"
                      onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                      إزالة
                    </salla-button>
                  </div>
                </div>
              </article>
            </form>
          {% else %}
            <div class="empty-bag" id="cart-page-empty">
              <span>طرازك يبدأ باختيار.</span>
              <h3>حقيبتك تنتظر ذوقك.</h3>
              <p>اكتشف مجموعة الأحذية المحاكة والكابات والشرابات وخفّ الكشخة.</p>
              <a href="{{ home_url }}#knit" class="primary">اكتشف المجموعة ←</a>
            </div>
          {% endfor %}
        </div>

        {% hook 'cart:items.end' %}

        <details class="cart-recommend" open>
          <summary>
            <span>كمّل كشختك <small>قطع تتناسق مع اختيارك · اختياري</small></span>
            <b>+</b>
          </summary>
          <div class="checkout-addons" id="cart-page-addons"></div>
        </details>
      </div>

      <aside class="cart-summary" id="cart-page-summary">
        <h3>ملخص طلبك</h3>

        {% hook 'cart:summary.start' %}

        <p><span>مجموع المنتجات</span><strong id="sub-total">{{ cart.sub_total|money }}</strong></p>

        {% if cart.options|default([])|length %}
          <div class="teraz-cart-options">
            {% for product_option in cart.options %}
              <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                <input type="hidden" name="id" value="{{ product_option.id }}">
                <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                {% include 'pages.partials.product.options' with { product: product_option } %}
              </form>
            {% endfor %}
          </div>
        {% endif %}

        <p id="shipping-cost" class="{{ cart.has_shipping ? '' : '' }}">
          <span>الشحن المتوقع</span>
          <strong>{{ (sub_num > 0 and sub_num < threshold) ? (shipping_fee ~ ' ر.س') : 'مجاني' }}</strong>
        </p>

        {% if store.settings.cart.apply_coupon_enabled %}
          <div class="teraz-coupon-box">
            <label for="coupon-input">كود الخصم</label>
            <div class="teraz-coupon-row">
              <input type="text" data-testid="store-cart-coupon-input" id="coupon-input" value="{{ cart.coupon }}" placeholder="أدخل كود الخصم" {{ cart.coupon ? 'disabled' : '' }}>
              <salla-button class="teraz-coupon-btn {{ cart.coupon ? 'has-coupon' : '' }}" data-testid="store-cart-coupon-btn" id="coupon-btn">
                <span class="coupon-text">{{ cart.coupon ? 'إلغاء' : 'تطبيق' }}</span>
              </salla-button>
            </div>
            <span class=" validation" id="coupon-error"></span>
          </div>
        {% endif %}

        <p id="total-discount" class="{{ cart.discount ? '' : 'hidden' }}">
          <span>الخصم</span>
          <strong>- {{ cart.discount|money }}</strong>
        </p>

        {% if cart.tax_amount %}
          <p><span>ضريبة القيمة المضافة</span><strong id="tax-amount">{{ cart.tax_amount|money }}</strong></p>
        {% endif %}

        <p class="grand-total">
          <span>الإجمالي المتوقع</span>
          <strong data-testid="store-cart-total" id="cart-total">{{ cart.total|money }}</strong>
        </p>

        <small>التكلفة النهائية للشحن وأي خصومات تظهر لك في صفحة الدفع. 14 يومًا للاسترجاع · 20 يومًا للاستبدال.</small>

        <div class="teraz-checkout-cta">
          {% hook 'cart:submit.start' %}
          <salla-button id="cart-submit" data-testid="store-cart-submit" loader-position="end" width="wide">
            إتمام الطلب ←
          </salla-button>
          {% hook 'cart:submit.end' %}
        </div>

        <a href="{{ home_url }}#knit" class="text-button">أكمل التصفح</a>
        {% hook 'cart:summary.end' %}
      </aside>
    </div>
  </section>
</div>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
