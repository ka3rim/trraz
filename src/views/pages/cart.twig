{#
  TERAZ 2.0 Cart Page (src/views/pages/cart.twig)
  Strictly follows Salla Twilight Documentation for Cart & Checkout
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('blocks.header.cart')|default('حقيبتك') }} | {{ store.name|default('طراز') }}{% endblock %}
{% block body_class %}teraz-cart-page{% endblock %}

{% block content %}
<section class="teraz-salla-cart-section" data-testid="store-cart-page" data-salla-cart-has-items="{{ cart.items|length ? 'true' : 'false' }}" {% if not (cart.items|length) %}hidden{% endif %}>
  <nav class="breadcrumbs w-full py-4">
    <salla-breadcrumb data-testid="store-breadcrumb"></salla-breadcrumb>
  </nav>
  <header class="teraz-subpage-header">
    <div>
      <span class="eyebrow">طراز · TERAZ</span>
      <h1 class="teraz-subpage-title">{{ trans('blocks.header.cart')|default('سلة المشتريات') }}</h1>
    </div>
  </header>

  <salla-conditional-offer data-testid="store-conditional-offer"></salla-conditional-offer>

  <div class="teraz-salla-cart-grid">
    <div class="cart-items-col">
      {% hook 'cart:items.start' %}

      {% for item in cart.items %}
        <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}" class="teraz-salla-cart-item" data-testid="store-cart-item">
          <input type="hidden" name="id" value="{{ item.id }}">
          <input type="hidden" name="pids[]" value="{{ item.product_id }}">

          <salla-cart-item-offers
            quantity="{{ item.quantity }}"
            item-id="{{ item.id }}"
            product-price="{{ item.product_price }}"
            offers="{{ item.offers|json_encode }}"></salla-cart-item-offers>

          <div class="teraz-salla-cart-item-row">
            <a href="{{ item.url }}" class="teraz-salla-cart-item-img">
              <img src="{{ item.product_image }}" alt="{{ item.product_name }}" loading="lazy">
            </a>
            <div>
              <h3><a href="{{ item.url }}">{{ item.product_name }}</a></h3>
              <p class="item-price">
                <span class="item-regular-price {{ item.is_on_sale ? '' : 'hidden' }}"><s>{{ item.regular_price|money }}</s></span>
                <strong class="item-sale-price">{{ item.price|money }}</strong>
              </p>
              {% if item.weight_label %}
                <p class="text-sm"><small>{{ trans('pages.products.weight') }}: {{ item.weight_label }}</small></p>
              {% endif %}
            </div>
            <div>
              {% if item.type == 'donating' %}
                <span></span>
              {% elseif item.is_hidden_quantity %}
                <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                <span class="item-quantity">{{ item.quantity }}</span>
              {% else %}
                <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                  class="tr-item-quantity" aria-label="Quantity"
                  value="{{ item.quantity }}" name="quantity" data-testid="store-cart-item-quantity">
                </salla-quantity-input>
              {% endif %}
            </div>
          </div>

          {% include 'pages.partials.product.options' with {product:item} %}

          <p class="mt-3">
            <span>{{ trans('pages.cart.item_total') }}: </span>
            <strong class="item-total">{{ item.is_available ? item.total|money : trans('pages.cart.out_of_stock') }}</strong>
          </p>

          <div class="mt-2">
            <salla-button type="button" shape="icon" size="small" color="danger" class="btn--delete" aria-label="Remove from the cart" data-testid="store-cart-item-delete" onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
              <i class="sicon-cancel"></i>
            </salla-button>
          </div>
        </form>
        {% if item.product_type != "group_products" %}
          <salla-offer product-id="{{ item.product_id }}"></salla-offer>
        {% endif %}
      {% endfor %}

      {% hook 'cart:items.end' %}
    </div>

    {% hook 'cart:summary.start' %}
    {% if cart.items|length %}
      <div class="teraz-salla-cart-summary-box">
        {% set free_shipping = cart.free_shipping_bar %}
        {% if free_shipping %}
          <div class="teraz-free-ship-box {{ (free_shipping.has_free_shipping or free_shipping.percent) ? '' : 'hidden' }}" id="free-shipping">
            <div class="flex items-center gap-3">
              <i class="sicon-shipping-fast"></i>
              {% set is_free = free_shipping.has_free_shipping %}
              <div class="text-sm" id="free-shipping-msg">
                {{ (is_free ? trans('pages.cart.has_free_shipping') : trans('pages.cart.free_shipping_alert', {'amount': free_shipping.remaining|money})) | raw }}
              </div>
            </div>
            <div class="teraz-free-ship-progress-bg {{ is_free ? ' hidden' : '' }}" id="free-shipping-bar">
              <div class="teraz-free-ship-progress-bar" style="width:{{ free_shipping.percent }}%"></div>
            </div>
          </div>
        {% endif %}

        {% if loyalty and user.loyalty_points %}
          <div class="mb-4">
            <salla-loyalty-panel
              customer-points="{{ user.loyalty_points }}"
              prize-points="{{ loyalty.prize.points }}"
              prize-title="{{ loyalty.prize.title }}"
            ></salla-loyalty-panel>
          </div>
        {% endif %}

        {% if cart.is_giftable %}
          <salla-gifting id="salla-gifting" {{ cart.is_Available_for_gifting ? '' : 'style="display:none"' }} widget-title="{{ trans('pages.cart.gift_widget_title') }}" widget-subtitle="{{ trans('pages.cart.gift_widget_description') }}" class="mb-5" cart-gifting {{ cart.is_require_shipping ? 'physical-products' : '' }}></salla-gifting>
        {% endif %}

        <div id="cart-gifting" class="shadow-default bg-white p-5 xs:p-7 rounded-md mb-5 relative {{ cart.gift ? '' : 'hidden' }}">
          <salla-gifting-list gift-data="{{ cart.gift|json_encode }}"></salla-gifting-list>
        </div>

        {% hook 'cart:coupon.start' %}
        {% if store.settings.cart.apply_coupon_enabled %}
          <salla-cart-coupons class="mb-5" data-testid="store-cart-coupons"></salla-cart-coupons>
        {% endif %}
        {% hook 'cart:coupon.end' %}

        {% hook 'cart:summary-card.start' %}
        <salla-cart-summary-card required-shipping="{{ cart.is_require_shipping }}" data-testid="store-cart-summary"></salla-cart-summary-card>
        {% hook 'cart:summary-card.end' %}

        {% hook 'cart:submit.start' %}
        <div class="mt-4">
          <salla-button id="cart-submit" loader-position="center" width="wide" data-testid="store-cart-submit" onclick="salla.cart.submit()">
            {{ trans('pages.cart.complete_order')|default('إتمام الطلب والدفع عبر سلة') }}
          </salla-button>
        </div>
        {% hook 'cart:submit.end' %}
      </div>
    {% endif %}
    {% hook 'cart:summary.end' %}
  </div>

  <salla-tiered-offer data-testid="store-tiered-offer"></salla-tiered-offer>
</section>

<div id="home-view">

  <section class="hero" id="home">
    <div class="hero-wording">
      <p class="eyebrow">للرجل السعودي، ولكل مشاويره</p>
      <h1>راحة تليق بالمقام.</h1>
      <p class="hero-sub">جزمة وحدة تمشي مع ثوبك وكاجوالك. خفيفة على رجلك، وفيها من الجلد اللي يعطيها هيبة.</p>
      <p class="hero-price">من <b>319 ريال</b> <span id="hero-rating"></span></p>
      <div class="hero-actions"><a class="primary" href="#knit">اختر جزمتك <span>←</span></a><a class="secondary" href="#offers">وش العروض؟</a></div>
    </div>
    <div class="atelier-stage" aria-label="ألوان طراز الثمانية على درج حجري">
      <img class="stage-bg" src="{{ theme.settings.get('teraz_hero_bg')|default('https://cdn.jsdelivr.net/gh/ka3rim/trraz@master/public/images/atelier.webp') }}" width="1536" height="1024" alt="" fetchpriority="high">
      <div id="hero-shoes"></div>
      <div id="hero-peek" aria-hidden="true"><img alt=""><span></span></div>
    </div>
  </section>

  <section class="trust-strip" id="trust" aria-label="ليش تطلب من طراز وانت مرتاح"></section>

  <nav class="quick-nav" aria-label="الأقسام">
    <a href="#knit">الأحذية</a><a href="#c/mule">لوفر الكشخة</a><a href="#c/clogs">الخف</a><a href="#c/caps">الكابات</a><a href="#c/socks">الشرابات</a><a href="#c/care">العناية</a><a href="#offers">العروض</a>
  </nav>

  <section class="section needs" id="needs">
    <header class="section-heading"><div><h2>وش مشوارك اليوم؟</h2><p>كل مشوار له جزمته. شوف وش يناسبك.</p></div></header>
    <div class="needs-grid" id="needs-grid"></div>
  </section>

  <section class="section collection" id="knit">
    <header class="section-heading">
      <div><h2>مجموعة الأناقة</h2><p>ثمان ألوان، وكل لون له مكانه. رتّبها على حسب لبسك.</p></div>
      <div class="strip-controls"><button type="button" data-scroll="knit" data-dir="1" aria-label="السابق">→</button><button type="button" data-scroll="knit" data-dir="-1" aria-label="التالي">←</button></div>
    </header>
    <div class="sort-bar" role="group" aria-label="رتّب حسب لبسك"><button type="button" data-sort="thobe" aria-pressed="true">مع الثوب</button><button type="button" data-sort="casual" aria-pressed="false">مع الكاجوال</button><button type="button" data-sort="walking" aria-pressed="false">للمشي</button></div>
    <div class="product-strip" data-group="knit" tabindex="0" aria-label="ألوان مجموعة الأناقة"></div>
  </section>

  <section class="section why" id="why">
    <div class="why-copy">
      <h2>ليش طراز؟</h2>
      <p class="lead">كلنا مرّينا فيها: الرياضي مريح بس ما يركب مع الثوب، والكلاسيكي يركب بس يتعبك في الحر. طراز جات بين الاثنين.</p>
      <ul class="why-facts">
        <li><b>نسيج محاك يهوّي</b> خفيف ويريّح رجلك في أجوائنا.</li>
        <li><b>جلد طبيعي حول الرباط والكعب</b> يعطيها شكل رسمي مع الثوب.</li>
        <li><b>فرشة مغطاة بجلد ماعز</b> تحسها من أول لبسة.</li>
      </ul>
      <a class="underlined" href="#knit">اختر أي لون وشوف تفاصيله عن قرب</a>
    </div>
    <div class="compare" role="table" aria-label="مقارنة طراز مع الرياضي والكلاسيكي">
      <div class="compare-row compare-head" role="row"><span role="columnheader"></span><span role="columnheader">الرياضي</span><span role="columnheader">الكلاسيكي الجلد</span><span role="columnheader" class="ours">طراز</span></div>
      <div class="compare-row" role="row"><span role="rowheader">مع الثوب</span><span role="cell">شكله غريب</span><span role="cell">يركب</span><span role="cell" class="ours">يركب، وله هيبة</span></div>
      <div class="compare-row" role="row"><span role="rowheader">مع الجينز</span><span role="cell">يركب</span><span role="cell">رسمي زيادة</span><span role="cell" class="ours">يركب</span></div>
      <div class="compare-row" role="row"><span role="rowheader">في الحر</span><span role="cell">يهوّي</span><span role="cell">حار وثقيل</span><span role="cell" class="ours">يهوّي</span></div>
      <div class="compare-row" role="row"><span role="rowheader">من الصبح لليل</span><span role="cell">مريح</span><span role="cell">يتعب</span><span role="cell" class="ours">مريح</span></div>
    </div>
  </section>

  <section class="section accessories" id="accessories">
    <header class="section-heading"><div><h2>كمّل كشختك</h2><p>التفاصيل الصغيرة هي اللي تفرق. كل قطعة هنا لونها مختار على ألوان جزمنا، عشان تطلع متناسق من راسك لرجلك.</p></div></header>
    <div id="category-rows"></div>
  </section>

  <section class="section offers" id="offers">
    <header class="section-heading"><div><h2>خذها لحالها، أو كمّلها وارتاح.</h2><p>كل ما زادت القطع، زاد اللي توفره.</p></div></header>
    <div class="offer-grid" id="home-offers"></div>
  </section>

  <section class="section reviews" id="reviews" hidden></section>

  <section class="section guarantee" id="guarantee">
    <div><h2>اطلب وانت مرتاح.</h2><p>جرّبها في البيت على راحتك. ما ضبط المقاس؟ نبدلها لك، وأول تبديل شحنه علينا.</p></div>
    <div class="guarantee-facts" id="guarantee-facts"></div>
  </section>

  <section class="section questions" id="questions">
    <div><h2>عندك سؤال؟</h2><p class="side-help" id="faq-help"></p></div>
    <div id="faq"></div>
  </section>

  <section class="section journal"><h2>قبل تختار</h2><div class="journal-grid">
    <details><summary><small>تنسيق</small>كيف تختار جزمتك مع الثوب؟</summary><p>ابدأ من ألوان لبسك. مع الثوب الأبيض، القاعدة البيضاء تعطي تباين خفيف، والقاعدة الداكنة حضورها أهدى. وإذا باقي تفاصيلك بنية، قرّب درجة الجزمة منها. ما يحتاج تكرر اللون في كل شي، يكفي رابط واحد بين الجزمة والكاب أو الشراب.</p></details>
    <details><summary><small>قبل تطلب</small>تطلب جزمة أونلاين لأول مرة؟</summary><p>قِس رجلك بالسنتي وطابقها مع جدول المقاسات. لما توصلك، جرّبها في البيت بالشراب اللي بتلبسه معها، وخل الكرتون معك لين تتأكد.</p></details>
    <details><summary><small>عناية</small>كيف تحافظ على النسيج والجلد؟</summary><p>امسح الغبار بفرشاة ناعمة، وجرّب المنظف على مكان ما يبين قبل. لا تغطسها في الموية ولا تنشفها على حرارة مباشرة.</p></details>
  </div></section>

  <section class="closing" id="join">
    <h2>خلك أول من يدري.</h2>
    <p>ننزل ألوان جديدة كل فترة، والمقاسات تخلص بسرعة. حط رقمك ونعلمك على الواتساب أول ما ينزل شي.</p>
    <form class="lead-form" id="lead-form" novalidate>
      <label class="visually-hidden" for="lead-phone">رقم الجوال</label>
      <input id="lead-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="05XXXXXXXX" dir="ltr">
      <button class="primary" type="submit">علّمني</button>
    </form>
    <p class="lead-message" id="lead-message" role="status"></p>
  </section>
</div>

<section id="product-view" hidden aria-label="صفحة المنتج"></section>
<section id="lp-view" hidden aria-label="عرض طراز"></section>
<section id="collection-view" hidden aria-label="المجموعة"></section>
<script>
  window.addEventListener('DOMContentLoaded', function() {
    var hasServerItems = document.querySelector('[data-salla-cart-has-items="true"]');
    if (!hasServerItems && typeof openCart === 'function') openCart('bag');
  });
</script>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
